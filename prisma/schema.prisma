generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClientConfig {
  id              String   @id @default(cuid())
  clientAccountId String   @unique
  clientName      String?
  metaPixelId     String?
  metaDatasetId   String?
  metaAccessToken String?
  metaSyncEnabled Boolean  @default(true)
  defaultCurrency String   @default("USD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LeadAttribution {
  id             String    @id @default(cuid())
  leadUid        String    @unique
  contactIdGhl   String?
  sourcePlatform String?
  sourceType     String?
  campaignId     String?
  campaignName   String?
  adsetId        String?
  adsetName      String?
  adId           String?
  adName         String?
  fbclid         String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  firstTouchAt   DateTime?
  latestTouchAt  DateTime?
}

enum LeadProofStatus {
  UNREVIEWED
  PROOF_ATTACHED
  PROOF_MISSING
  NEEDS_REVIEW
  REJECTED
}

enum LeadVerificationStatus {
  UNCHECKED
  PASSED
  FAILED
  NEEDS_REVIEW
}

enum LeadDuplicateStatus {
  UNCHECKED
  UNIQUE
  DUPLICATE_GLOBAL
  DUPLICATE_BUYER
  DUPLICATE_RECENT
  POSSIBLE_MATCH
}

enum LeadVerificationApprovalActionType {
  APPROVE_UNIQUE
  REVOKE_TO_REVIEW
}

enum LeadVerificationApprovalStatus {
  applied
  rejected
  idempotent_replay
}

enum Lf2CheckpointAActionType {
  CREATE_CONFIG
  REVOKE_CONFIG
}

enum Lf2CheckpointAStatus {
  applied
  rejected
  idempotent_replay
}

enum LeadProofReviewActionType {
  APPROVE_PROOF
  REJECT_PROOF
  REVOKE_TO_REVIEW
}

enum LeadProofReviewStatus {
  applied
  rejected
  idempotent_replay
}

enum LeadCaptureTrustSyncAction {
  PREVIEW
  ATTACH
  RECONCILE_PREVIEW
}

enum LeadCaptureTrustSyncReviewStatus {
  applied
  idempotent_replay
  blocked
  preview_only
}

enum LeadCaptureTrustCorrelationClassification {
  exact_match
  preview_identity_match
  ambiguous
  no_match
  campaign_mismatch
  client_mismatch
  source_lane_mismatch
}

enum LeadProofArtifactProvider {
  leadcapture_io
  leadconduit_facebook
  meta_lead_ads
  trustedform
  manual
  unknown
}

enum LeadProofArtifactType {
  CONSENT_CERTIFICATE
  CRYPTOGRAPHIC_INTEGRITY
}

enum LeadProofArtifactStatus {
  CAPTURED
  MISSING
  NEEDS_REVIEW
}

model LeadProof {
  id                   String              @id @default(cuid())
  leadUid              String              @unique
  sourceLeadId         String?
  sourceLane           String?
  sourcePlatform       String?
  sourceType           String?
  campaignId           String?
  campaignName         String?
  adsetId              String?
  adsetName            String?
  adId                 String?
  adName               String?
  formId               String?
  formName             String?
  landingPageUrl       String?
  referrerUrl          String?
  consentText          String?             @db.Text
  consentVersion       String?
  consentCapturedAt    DateTime?
  privacyPolicyVersion String?
  termsVersion         String?
  submittedAt          DateTime?
  ipAddress            String?
  userAgent            String?             @db.Text
  phoneRaw             String?
  phoneE164            String?
  email                String?
  proofStatus          LeadProofStatus     @default(UNREVIEWED)
  proofMissingReasons  Json?
  rawSourcePayload     Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  proofArtifacts       LeadProofArtifact[]

  @@index([proofStatus, updatedAt])
  @@index([sourceLane, updatedAt])
  @@index([campaignId, updatedAt])
}

model LeadProofArtifact {
  id                  String                    @id @default(cuid())
  leadProofId         String
  leadProof           LeadProof                 @relation(fields: [leadProofId], references: [id], onDelete: Cascade)
  provider            LeadProofArtifactProvider
  artifactType        LeadProofArtifactType
  status              LeadProofArtifactStatus   @default(CAPTURED)
  externalReference   String?
  certificateUrl      String?
  integrityHash       String?
  signature           String?
  algorithm           String?
  keyId               String?
  capturedAt          DateTime?
  issuedAt            DateTime?
  verifiedAt          DateTime?
  retainedAt          DateTime?
  expiresAt           DateTime?
  artifactFingerprint String
  providerMetadata    Json?
  failureReasons      Json?
  rawArtifactPayload  Json?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([leadProofId, artifactFingerprint])
  @@index([leadProofId, provider, artifactType])
  @@index([status, updatedAt])
}

model ConsentDisclosureVersion {
  id               String    @id @default(cuid())
  versionKey       String    @unique
  sourcePlatform   String?
  formId           String?
  formName         String?
  disclosureText   String    @db.Text
  privacyPolicyUrl String?
  termsUrl         String?
  active           Boolean   @default(true)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([active, effectiveFrom])
  @@index([sourcePlatform, formId])
}

model LeadSourceSnapshot {
  id                String   @id @default(cuid())
  leadUid           String   @unique
  sourceLane        String?
  sourcePlatform    String?
  sourceType        String?
  sourceLeadId      String?
  sourceAttributes  Json?
  routingAttributes Json?
  rawPayload        Json?
  capturedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sourceLane, capturedAt])
  @@index([sourcePlatform, sourceType, capturedAt])
}

model LeadVerificationResult {
  id                 String                 @id @default(cuid())
  leadUid            String                 @unique
  verificationStatus LeadVerificationStatus @default(UNCHECKED)
  duplicateStatus    LeadDuplicateStatus?
  phoneStatus        String?
  emailStatus        String?
  suppressionStatus  String?
  qualityScore       Int?
  reasons            Json?
  checkedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([verificationStatus, updatedAt])
  @@index([duplicateStatus, updatedAt])
}

/// Audit trail for operator-approved LF2 duplicate verification decisions.
model LeadVerificationApprovalAuditEvent {
  id                            String                             @id @default(cuid())
  sourceLeadEventId             String
  sourceLeadUidMasked           String?
  leadUid                       String
  clientAccountId               String
  destinationSubaccountIdGhl    String
  actionType                    LeadVerificationApprovalActionType
  previousVerificationStatus    LeadVerificationStatus?
  previousDuplicateStatus       LeadDuplicateStatus?
  newVerificationStatus         LeadVerificationStatus?
  newDuplicateStatus            LeadDuplicateStatus?
  phoneFingerprint              String?
  emailFingerprint              String?
  duplicateSearchClassification String?
  duplicateSearchReasonCode     String?
  phoneSearchOutcome            String?
  emailSearchOutcome            String?
  matchedContactIdGhl           String?
  approvalStatus                LeadVerificationApprovalStatus
  reasonsJson                   Json?
  metadataJson                  Json?
  requestedBy                   String?
  requestId                     String?
  createdAt                     DateTime                           @default(now())

  @@index([sourceLeadEventId, createdAt])
  @@index([leadUid, createdAt])
  @@index([clientAccountId, createdAt])
  @@index([destinationSubaccountIdGhl, createdAt])
  @@index([requestId])
}

/// Append-only audit trail for LF2 operator proof-review decisions.
model LeadProofReviewAuditEvent {
  id                         String                    @id @default(cuid())
  sourceLeadEventId          String
  leadProofId                String?
  sourceLeadUidMasked        String?
  leadUidFingerprint         String
  clientAccountId            String
  canonicalSourceLane        String
  proofPolicyKey             String
  actionType                 LeadProofReviewActionType
  previousProofStatus        LeadProofStatus?
  extractedProofStatus       LeadProofStatus?
  newProofStatus             LeadProofStatus?
  previousVerificationStatus LeadVerificationStatus?
  previousDuplicateStatus    LeadDuplicateStatus?
  reviewStatus               LeadProofReviewStatus
  evidenceSummaryJson        Json?
  reasonsJson                Json?
  metadataJson               Json?
  requestedBy                String?
  operatorNote               String?
  requestId                  String
  createdAt                  DateTime                  @default(now())

  @@unique([sourceLeadEventId, requestId])
  @@index([sourceLeadEventId, createdAt])
  @@index([clientAccountId, createdAt])
  @@index([leadProofId])
  @@index([actionType, createdAt])
  @@index([createdAt])
}

/// Append-only audit for LeadCapture Data API trust-form proof sync (pilot).
model LeadCaptureTrustSyncAuditEvent {
  id                        String                                    @id @default(cuid())
  sourceLeadEventId         String
  leadProofId               String?
  providerLeadIdFingerprint String
  maskedProviderLeadId      String?
  campaignId                String
  formId                    String?
  clientAccountId           String
  action                    LeadCaptureTrustSyncAction
  priorContentHash          String?
  newContentHash            String?
  correlationClassification LeadCaptureTrustCorrelationClassification
  previousProofStatus       LeadProofStatus?
  newProofStatus            LeadProofStatus?
  reviewStatus              LeadCaptureTrustSyncReviewStatus
  completenessStatus        String?
  missingFieldsJson         Json?
  warningsJson              Json?
  requestId                 String
  requestedBy               String?
  operatorNote              String?
  createdAt                 DateTime                                  @default(now())

  @@unique([sourceLeadEventId, requestId])
  @@index([sourceLeadEventId, createdAt])
  @@index([providerLeadIdFingerprint, newContentHash])
  @@index([campaignId, createdAt])
  @@index([clientAccountId, createdAt])
  @@index([action, createdAt])
}

/// Audit trail for LF2 Checkpoint A configuration create/revoke decisions.
model Lf2CheckpointAAuditEvent {
  id                         String                   @id @default(cuid())
  sourceLeadEventId          String
  sourceLeadUidMasked        String?
  clientAccountId            String
  destinationSubaccountIdGhl String
  leadOrderId                String?
  deliveryTargetId           String?
  actionType                 Lf2CheckpointAActionType
  checkpointAStatus          Lf2CheckpointAStatus
  reasonsJson                Json?
  metadataJson               Json?
  requestedBy                String?
  requestId                  String?
  createdAt                  DateTime                 @default(now())

  @@index([sourceLeadEventId, createdAt])
  @@index([clientAccountId, createdAt])
  @@index([leadOrderId, createdAt])
  @@index([deliveryTargetId, createdAt])
  @@index([requestId])
}

model LifecycleEvent {
  id                String    @id @default(cuid())
  eventUuid         String    @unique
  clientAccountId   String
  subaccountIdGhl   String?
  leadUid           String
  contactIdGhl      String?
  eventNameInternal String
  eventNameMeta     String
  payloadJson       Json
  status            String    @default("received")
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?
}

model MetaDispatchAttempt {
  id            String   @id @default(cuid())
  eventUuid     String
  attemptNumber Int
  requestJson   Json?
  responseJson  Json?
  httpStatus    Int?
  success       Boolean  @default(false)
  errorMessage  String?
  attemptedAt   DateTime @default(now())
}

model FailedDispatch {
  id            String   @id @default(cuid())
  eventUuid     String   @unique
  failureReason String
  retryCount    Int      @default(0)
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum InboundContactSourceOrigin {
  lifecycle_webhook
  ghl_backfill
  merged
}

enum InboundContactClientStatus {
  LEAD
  EXISTING_CLIENT
  UNKNOWN
}

enum WebhookRequestSource {
  ghl_lifecycle
  synthflow_inbound_lookup
  leadcapture_io
  facebook_lead_ads
  google_sheets
}

enum SourceLeadProvider {
  leadcapture_io
  facebook
  goat_leads
  manual_import
  google_sheets
  unknown
}

enum SourceLeadSystem {
  leadcapture_io_legacy
  leadcapture_io_nextgen
  meta_lead_ads
  external_vendor
  csv_import
  google_sheet_import
}

enum SourceLeadType {
  webhook
  lead_form
  bulk_import
  api_import
  manual_entry
}

enum SourceLeadEventStatus {
  received
  normalized
  routing_matched
  routing_unmatched
  duplicate_blocked
  needs_review
  approved
  delivered
  delivery_failed
  rejected
}

enum BulkLeadImportStatus {
  uploaded
  parsing
  mapping_required
  ready_for_review
  ready_for_simulation
  simulation_running
  simulation_complete
  approved_for_delivery
  delivery_running
  paused
  partial_success
  completed
  failed
  cancelled
}

enum BulkLeadImportRowValidationStatus {
  pending
  eligible
  identity_blocked
  duplicate_review
  mapping_required
  destination_blocked
  ready_for_simulation
  excluded
  failed
}

enum BulkLeadImportRowDuplicateStatus {
  none
  within_batch_duplicate
  source_duplicate
  phone_email_review
  blocked
