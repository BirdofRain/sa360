  @@unique([reviewActionId, leadInventoryItemId])
  @@index([leadInventoryItemId, createdAt])
  @@index([reviewActionId, createdAt])
}

// --- Historical ownership and resale registry (schema only) ---
// Decision procedures live in migration SQL:
//   historical_campaign_ownership_decision
//   historical_resale_authorization_decision
// Docs: docs/development/historical-ownership-resale-registry.md
// These models do not stamp LeadInventoryItem.originClientAccountId and do not
// authorize resale from exclusivity, acquisition cost, Used By, or a label.

enum HistoricalRegistryScopeType {
  inventory_lot
  import_request
}

enum HistoricalCampaignAliasStatus {
  unassigned
  suggested
  confirmed
  conflicted
  retired
}

enum HistoricalCampaignAliasAction {
  recorded
  suggested
  confirmed
  reassigned
  conflicted
  retired
}

/// Optional alias evidence. A note is a different column and is not one of these types.
enum HistoricalCampaignAliasEvidenceType {
  july_label_record
  operator_case_file
  external_correspondence
}

enum HistoricalResaleAuthorizationStatus {
  proposed
  confirmed
  revoked
}

enum HistoricalResaleAuthorizationAction {
  proposed
  confirmed
  revoked
}

/// Independently verified resale evidence. Operator notes, labels, exclusivity, and Used By are not members.
enum HistoricalResaleEvidenceType {
  purchase_agreement
  license
  acquisition_record
}

/// One original July campaign label inside one inventory lot or one import request.
/// `originClientAccountId` stays null until status is confirmed. Retired rows may retain the last client.
/// Scope identity and labels are immutable. Partial live-resale uniqueness is not on this table.
model HistoricalCampaignAlias {
  id                    String                         @id @default(cuid())
  scopeType             HistoricalRegistryScopeType
  /// InventoryLot.lotKey or the census import-request key. Not a foreign key to inventory.
  scopeKey              String
  /// July sourceCampaignName after trim and internal-whitespace collapse. Case is significant.
  normalizedLabel       String
  /// One preserved July sourceCampaignName. Its normalized form equals normalizedLabel.
  displayLabel          String
  originClientAccountId String?
  originClientAccount   ClientAccount?                 @relation("HistoricalCampaignAliasOrigin", fields: [originClientAccountId], references: [clientAccountId], onDelete: Restrict, onUpdate: Restrict)
  status                HistoricalCampaignAliasStatus  @default(unassigned)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  events HistoricalCampaignAliasEvent[]

  @@unique([scopeType, scopeKey, normalizedLabel], map: "HistoricalCampaignAlias_scope_label_key")
  @@index([scopeType, scopeKey], map: "HistoricalCampaignAlias_scope_idx")
  @@index([originClientAccountId], map: "HistoricalCampaignAlias_origin_idx")
  @@index([status], map: "HistoricalCampaignAlias_status_idx")
}

/// Append-only ownership history. Sequence is assigned by the database.
/// Reassignment inserts a row; it does not rewrite an earlier event.
model HistoricalCampaignAliasEvent {
  id                            String                              @id @default(cuid())
  aliasId                       String
  alias                         HistoricalCampaignAlias             @relation(fields: [aliasId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Database-assigned. Callers cannot choose the order.
  sequence                      Int                                 @default(0)
  action                        HistoricalCampaignAliasAction
  previousOriginClientAccountId String?
  previousOriginClientAccount   ClientAccount?                      @relation("HistoricalCampaignAliasEventPreviousOrigin", fields: [previousOriginClientAccountId], references: [clientAccountId], onDelete: Restrict, onUpdate: Restrict, map: "HistAliasEvent_prev_origin_fkey")
  nextOriginClientAccountId     String?
  nextOriginClientAccount       ClientAccount?                      @relation("HistoricalCampaignAliasEventNextOrigin", fields: [nextOriginClientAccountId], references: [clientAccountId], onDelete: Restrict, onUpdate: Restrict, map: "HistAliasEvent_next_origin_fkey")
  actor                         String
  /// Operator text. Not an evidence reference.
  note                          String?
  evidenceReference             String?
  evidenceType                  HistoricalCampaignAliasEvidenceType?
  requestId                     String
  createdAt                     DateTime                            @default(now())

  @@unique([aliasId, sequence], map: "HistAliasEvent_alias_seq_key")
  @@unique([requestId], map: "HistAliasEvent_request_id_key")
  @@index([previousOriginClientAccountId], map: "HistAliasEvent_prev_origin_idx")
  @@index([nextOriginClientAccountId], map: "HistAliasEvent_next_origin_idx")
  @@index([aliasId, createdAt], map: "HistAliasEvent_alias_created_idx")
}

/// Resale rights for one scope. Independent of HistoricalCampaignAlias.
/// At most one proposed or confirmed row per scope (partial unique index in SQL).
/// A confirmed row past expiresAt stays stored and is not eligible.
model HistoricalResaleAuthorization {
  id                  String                               @id @default(cuid())
  scopeType           HistoricalRegistryScopeType
  scopeKey            String
  status              HistoricalResaleAuthorizationStatus  @default(proposed)
  /// External record id. Prefix agreement:, license:, or acquisition:. Not a document body.
  evidenceReference   String?
  evidenceType        HistoricalResaleEvidenceType?
  /// Short verification record. Not a document, label, exclusivity mode, or Used By value.
  verificationDetails String?
  /// Operator text. Never sufficient for status confirmed.
  operatorNote        String?
  authorizedOperator  String?
  verifiedAt          DateTime?
  effectiveAt         DateTime?
  expiresAt           DateTime?
  revokedAt           DateTime?
  revocationReason    String?
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt

  events HistoricalResaleAuthorizationEvent[]

  @@index([scopeType, scopeKey], map: "HistoricalResaleAuthorization_scope_idx")
  @@index([status, expiresAt], map: "HistoricalResaleAuthorization_status_exp_idx")
}

/// Append-only proposal, confirmation, and revocation history.
model HistoricalResaleAuthorizationEvent {
  id                  String                               @id @default(cuid())
  authorizationId     String
  authorization       HistoricalResaleAuthorization        @relation(fields: [authorizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sequence            Int                                  @default(0)
  action              HistoricalResaleAuthorizationAction
  previousStatus      HistoricalResaleAuthorizationStatus?
  nextStatus          HistoricalResaleAuthorizationStatus
  actor               String
  evidenceReference   String?
  evidenceType        HistoricalResaleEvidenceType?
  verificationDetails String?
  operatorNote        String?
  authorizedOperator  String?
  verifiedAt          DateTime?
  effectiveAt         DateTime?
  expiresAt           DateTime?
  revokedAt           DateTime?
  revocationReason    String?
  requestId           String
  createdAt           DateTime                             @default(now())

  @@unique([authorizationId, sequence], map: "HistoricalResaleAuthEvent_auth_seq_key")
  @@unique([requestId], map: "HistoricalResaleAuthEvent_request_id_key")
  @@index([authorizationId, createdAt], map: "HistoricalResaleAuthEvent_created_idx")
}

/// Catalog read model only. One row per historical inventory item.
/// Fulfillment, sellability, reservation, and buyer eligibility must not read this table.
/// There is no foreign key to LeadInventoryItem: intake deletes must not depend on this row.
model HistoricalCatalogProjection {
  itemId           String   @id @map("item_id")
  lotKey           String   @map("lot_key")
  importRequest    String   @map("import_request")
  nicheKey         String   @map("niche_key")
  itemStatus       String   @map("item_status")
  originId         String?  @map("origin_id")
  julyLabel        String?  @map("july_label")
  normalizedLabel  String?  @map("normalized_label")
  labelAgreement   String   @map("label_agreement")
  /// Trigger writes use clock_timestamp(). Backfill may update a row only when this is older.
  /// timestamptz so the comparison is an absolute instant, not a session wall time.
  refreshedAt      DateTime @map("refreshed_at") @db.Timestamptz(6)

  @@map("historical_catalog_projection")
}

/// Single control row. ready stays false until a separately approved backfill is verified.
/// The historical catalog query must not read the projection while ready is false.
model HistoricalCatalogProjectionControl {
  singleton          Boolean   @id @default(true)
  ready              Boolean   @default(false)
  sourceRowCount     BigInt?   @map("source_row_count")
  projectionRowCount BigInt?   @map("projection_row_count")
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  note               String?

  @@map("historical_catalog_projection_control")
}

/// Surrogate identity for one July label and its normalized form.
/// labelHash is an md5 lookup aid. It is not a unique identity.
/// July text can exceed the btree index tuple limit, so it is not part of the bucket grain.
model HistoricalCatalogSummaryLabel {
  labelPairId     BigInt  @id @default(autoincrement()) @map("label_pair_id")
  julyLabel       String? @map("july_label")
  normalizedLabel String? @map("normalized_label")
  labelHash       String  @map("label_hash")

  buckets HistoricalCatalogSummaryBucket[]

  @@index([labelHash], map: "historical_catalog_summary_label_hash")
  @@map("historical_catalog_summary_label")
}

/// One pre-aggregated catalog bucket. The API does not read this table in the schema gate.
/// The grain unique constraint is UNIQUE NULLS NOT DISTINCT in SQL. Prisma maps the same
/// columns so a diff does not drop it. Do not replace that constraint with NULLS DISTINCT.
/// There is no foreign key to LeadInventoryItem, InventoryLot, or SourceLeadEvent.
model HistoricalCatalogSummaryBucket {
  bucketId        BigInt                        @id @default(autoincrement()) @map("bucket_id")
  lotKey          String                        @map("lot_key")
  rawLotKey       String?                       @map("raw_lot_key")
  importRequest   String                        @map("import_request")
  labelPairId     BigInt                        @map("label_pair_id")
  labelPair       HistoricalCatalogSummaryLabel @relation(fields: [labelPairId], references: [labelPairId], onDelete: Restrict, onUpdate: Restrict)
  normalizedLabel String?                       @map("normalized_label")
  julyLabel       String?                       @map("july_label")
  originId        String?                       @map("origin_id")
  nicheKey        String                        @map("niche_key")
  rawNicheKey     String?                       @map("raw_niche_key")
  itemStatus      String                        @map("item_status")
  labelAgreement  String                        @map("label_agreement")
  /// Nonnegative count. CHECK (n >= 0) is enforced in SQL.
  n               Int
  touchedEpoch    BigInt                        @default(0) @map("touched_epoch")

  memberships HistoricalCatalogSummaryMembership[]

  @@unique([lotKey, rawLotKey, importRequest, labelPairId, originId, nicheKey, rawNicheKey, itemStatus, labelAgreement], map: "historical_catalog_summary_bucket_grain")
  @@index([lotKey, rawLotKey], map: "historical_catalog_summary_bucket_lot")
  @@index([rawLotKey], map: "historical_catalog_summary_bucket_raw_lot")
  @@index([importRequest], map: "historical_catalog_summary_bucket_import")
  @@index([nicheKey, rawNicheKey], map: "historical_catalog_summary_bucket_niche")
  @@map("historical_catalog_summary_bucket")
}

/// Previous bucket contribution for one inventory item id.
/// itemId is not a foreign key. Deleting the bucket is restricted while a membership points at it.
/// CHECK (accounted = (bucket_id IS NOT NULL)) is enforced in SQL.
model HistoricalCatalogSummaryMembership {
  itemId    String                         @id @map("item_id")
  bucketId  BigInt?                        @map("bucket_id")
  bucket    HistoricalCatalogSummaryBucket? @relation(fields: [bucketId], references: [bucketId], onDelete: Restrict, onUpdate: Restrict)
  accounted Boolean
  appliedAt DateTime?                      @map("applied_at") @db.Timestamptz(6)

  @@map("historical_catalog_summary_membership")
}

/// Separate from the projection control row. summaryReady stays false until a later authorize step.
/// reconciledEpoch and reconciledAt stay null on creation.
model HistoricalCatalogSummaryControl {
  singleton       Boolean   @id @default(true)
  summaryReady    Boolean   @default(false) @map("summary_ready")
  summaryEpoch    BigInt    @default(0) @map("summary_epoch")
  reconciledEpoch BigInt?   @map("reconciled_epoch")
  reconciledAt    DateTime? @map("reconciled_at") @db.Timestamptz(6)
  invalidatedAt   DateTime? @map("invalidated_at") @db.Timestamptz(6)
  invalidation    String?
  failureCount    BigInt    @default(0) @map("failure_count")
  note            String?

  @@map("historical_catalog_summary_control")
}

/// Durable checkpoint for a later bounded backfill. No backfill is installed with this table.
/// status is constrained in SQL to running, complete, or failed.
model HistoricalCatalogSummaryCheckpoint {
  chunkId      BigInt    @id @default(autoincrement()) @map("chunk_id")
  rangeAfter   String    @map("range_after")
  rangeUntil   String    @map("range_until")
  status       String
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  itemsApplied Int?      @map("items_applied")
  note         String?

  @@index([status], map: "historical_catalog_summary_checkpoint_status")
  @@map("historical_catalog_summary_checkpoint")
}

/// Operator choice for onboarding v2 destinations.
/// Location id, workflow id, and trigger mode stay on ClientGhlDestination.
/// This row does not store OAuth tokens, webhook secrets, or GHL credentials.
/// sheetsSelected and revision do not write CompanySheetsDestination.
/// ghlMode: unset | location_api | inbound_webhook | external_zapier.
/// notesContractVersion is sa360_lead_note_v2 only while notes are enabled.
model ClientOnboardingDestinationProfile {
  id                    String        @id @default(cuid())
  clientAccountId       String        @unique
  clientAccount         ClientAccount @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  ghlMode               String        @default("unset")
  notesEnabled          Boolean       @default(false)
  notesContractVersion  String?
  sheetsSelected        Boolean       @default(false)
  /// Optimistic concurrency token for the onboarding destination PUT.
  revision              Int           @default(1)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

/// Client-scoped verified test contact. At least one of email or phone is required.
/// There is no address column and no seeded test contact.
/// SQL partial unique indexes are clientAccountId + lower(email), and clientAccountId + phoneE164.
model ClientOnboardingVerifiedTestIdentity {
  id              String        @id @default(cuid())
  clientAccountId String
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  email           String?
  phoneE164       String?
  /// How the operator verified the contact. Hashes and labels only. No secrets.
  evidenceJson    Json          @default("{}")
  verifiedAt      DateTime      @default(now())
  actorLabel      String?
  requestId       String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clientAccountId, verifiedAt])
}

/// One approved exact-v3 test worksheet per client.
/// Header equality, the 35-cell snapshot, and control basis are enforced in SQL.
/// This is not a CompanySheetsTabContract and it does not bind or create a Google file.
model ClientOnboardingTestWorksheet {
  id                   String        @id @default(cuid())
  clientAccountId      String        @unique
  clientAccount        ClientAccount @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  spreadsheetId        String
  worksheetId          Int
  worksheetTitle       String
  /// company_sheets_campaign_v3. The Canary schema cannot be stored here.
  schemaVersion        String
  header               Json
  headerSha256         String
  destinationRevision  Int
  /// establishControl result. Failure codes are rejected in SQL.
  controlBasis         Json
  approvedAt           DateTime
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([spreadsheetId, worksheetId], map: "ClientOnboardingTestWorksheet_sheet_key")
}

/// One onboarding test request. requestSnapshot is immutable.
/// Status uncertain cannot be updated into another outcome.
/// resendAuthorized, appendStartedAtCleared, locksCleared, and providerWebhookCalled
/// are constrained false. They are not write handles on CompanySheetsDeliveryJob
/// or CompanySheetsWorksheetLock.
/// kind: preview | captured_event_replay | captured_event_delivery | synthetic_delivery.
/// status: previewed | executing | succeeded | failed | uncertain | note_too_long.
/// isolationMode: verified_test_identity | isolated_destination.
/// sheetsContract column: exact_v3_test_worksheet | canary_v1_projection | null.
/// A custom campaign test stores null in the column. requestSnapshot records custom_campaign_map.
/// repeatOfTestRunId is a deferred restrict foreign key in SQL.
model ClientOnboardingTestRun {
  id                      String                       @id @default(cuid())
  clientAccountId         String
  clientAccount           ClientAccount                @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  kind                    String
  sourceLeadEventId       String?
  sourceLeadEvent         SourceLeadEvent?             @relation(fields: [sourceLeadEventId], references: [id], onDelete: Restrict)
  destinations            Json
  isolationMode           String?
  sheetsContract          String?
  repeatOfTestRunId       String?
  repeatOfTestRun         ClientOnboardingTestRun?     @relation("ClientOnboardingTestRunRepeat", fields: [repeatOfTestRunId], references: [id], onDelete: Restrict)
  repeats                 ClientOnboardingTestRun[]    @relation("ClientOnboardingTestRunRepeat")
  requestId               String                       @unique
  status                  String
  /// Frozen copy of the operator request. Not a lead payload and not a secret.
  requestSnapshot         Json
  previewJson             Json?
  warningCodes            Json                         @default("[]")
  /// complete | discarded_duplicates | not_recoverable. No raw form answers.
  qaEvidenceJson          Json?
  noteBodySha256          String?
  sheetRowSha256          String?
  resendAuthorized        Boolean                      @default(false)
  appendStartedAtCleared  Boolean                      @default(false)
  locksCleared            Boolean                      @default(false)
  providerWebhookCalled   Boolean                      @default(false)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  attempts                ClientOnboardingTestAttempt[]

  @@index([clientAccountId, createdAt], map: "ClientOnboardingTestRun_client_created_idx")
  @@index([clientAccountId, sourceLeadEventId, status], map: "ClientOnboardingTestRun_client_event_status_idx")
  @@index([status, createdAt], map: "ClientOnboardingTestRun_status_created_idx")
}

/// One independent attempt for one destination on a test run.
/// idempotencyKey is an onboarding-test key, never a production delivery key.
/// Additional contact, note-part, and workflow keys live on ClientOnboardingTestAttemptKey.
/// destination: google_sheets | ghl_location_api | ghl_inbound_webhook.
/// status: previewed | executing | succeeded | failed | uncertain | not_executed.
/// appendStartedAt is evidence on this attempt. Updating it does not clear a delivery job.
model ClientOnboardingTestAttempt {
  id                       String                            @id @default(cuid())
  testRunId                String
  testRun                  ClientOnboardingTestRun           @relation(fields: [testRunId], references: [id], onDelete: Cascade)
