  deliveredRows              Int                  @default(0)
  failedRows                 Int                  @default(0)
  destinationClientAccountId String?
  destinationLocationIdGhl   String?
  sourceRouteKey             String?
  mappingJson                Json?
  defaultValuesJson          Json?
  enrichmentPolicyJson       Json?
  importOptionsJson          Json?
  wizardStepJson             Json?
  approvedAt                 DateTime?
  approvedBy                 String?
  startedAt                  DateTime?
  completedAt                DateTime?
  pausedAt                   DateTime?
  failureSummaryJson         Json?
