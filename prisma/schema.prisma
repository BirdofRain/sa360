  payloadHash                  String
  /// Immutable result of the save command.
  recordResultJson             Json
  /// ADMIN for the shared admin key. A named staff write stores StaffPrincipal.id.
  /// Set from a verified staff assertion. Not a role, email, or browser label.
  actor                        String
  supersededByRequestId        String?
  supersededAt                 DateTime?
  createdAt                    DateTime                                   @default(now())
  updatedAt                    DateTime                                   @updatedAt

  @@unique([clientAccountId, revision])
  @@index([clientAccountId, createdAt], map: "GhlDestinationConfigRequest_client_created_idx")
}

/// Intended Company Sheets spreadsheet id and worksheet id.
/// This is not CompanySheetsDestination. Delivery, dispatch, routing, column
/// maps, and fulfillment do not read it. SQL checks and the snapshot trigger
/// reject identifier edits and an insert that is already superseded. The
