/// How a stored Meta Graph credential was issued. A system user credential may
/// authorize many Pages; each Page still has its own capture grant.
enum MetaGraphCredentialKind {
  page_access_token
  system_user
}

/// Operator-facing credential health. `active` is the only status the fetcher uses.
enum MetaGraphCredentialStatus {
  active
  disabled
  expired
  revoked
  missing_permission
}

/// Encrypted Meta Page or System User token for Lead Ads Graph retrieval.
/// Plaintext is never stored. The encryption key is META_TOKEN_ENCRYPTION_KEY
/// and is not shared with GHL or Google. Creating a row does not enable intake,
/// Graph fetch, routing, delivery, or Page capture.
model MetaGraphCredential {
  id               String                     @id @default(cuid())
  kind             MetaGraphCredentialKind
  /// Operator label. Never a token or secret.
  label            String
  /// AES-256-GCM ciphertext (`iv.tag.ciphertext`, base64url). Server-side only.
  tokenCiphertext  String
  /// SHA-256 prefix so operators can tell credentials apart. Not a secret.
  tokenFingerprint String
  tokenVersion     Int                        @default(1)
  appId            String?
  /// Null means Meta reported no expiry (long-lived Page token).
  expiresAt        DateTime?
  /// Scopes observed from debug_token. Empty until an operator runs diagnostics.
  scopes           Json                       @default("[]")
  status           MetaGraphCredentialStatus  @default(active)
  lastCheckedAt    DateTime?
  /// Token-free diagnostic from the last check or Graph refusal.
  lastDiagnostic   String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  pageGrants       MetaPageCaptureGrant[]

  @@index([status])
}

/// Page-level capture allowlist. Default false, so storing a token does not
/// authorize Graph retrieval for that Page. Independent of the global Meta
/// intake, Graph fetch, routing, and delivery flags.
model MetaPageCaptureGrant {
  id             String              @id @default(cuid())
  pageId         String              @unique
  pageName       String?
  credentialId   String
  credential     MetaGraphCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  captureEnabled Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([credentialId])
  @@index([captureEnabled])
}

/// Candidate Page + Form evidence supplied by an operator registry or a later
/// read-only discovery diff. Not client ownership. Import must not create a
/// ClientAccount or write SourceFunnel.originClientAccountId.
model MetaFormCandidate {
  id           String   @id @default(cuid())
  pageId       String
  formId       String
  pageName     String?
  formName     String?
  campaignId   String?
  campaignName String?
  adsetId      String?
  adId         String?
  adAccountId  String?
  /// Operator source name, for example sanitized_campaign_registry.
  sourceLabel  String
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([pageId, formId, sourceLabel])
  @@index([pageId])
}

/// v1 notification channel. `sms` is not a value until a sender exists.
/// The preference row can store an optional verified E.164 and `smsEnabled`
/// without adding that value. Those columns do not send.
enum ClientDeliveryNotificationChannel {
  email
}

/// Which external webhook the client pasted. Both kinds are the primary CRM
/// delivery for that client. Company Sheets is a separate table and stays parallel.
enum ExternalWebhookDestinationKind {
  ghl_inbound
  external_https
}

/// Optional request signing. `none` is the GHL inbound default: the unguessable
/// path is the credential and is stored only as URL ciphertext.
enum ExternalWebhookAuthMode {
  none
  hmac_sha256
}

/// `recorded` means the frozen payload is stored and the request has not left SA360.
/// `sending` is the single in-flight claim. A crash leaves it sending; recovery
/// promotes a stale claim to uncertain and does not POST again.
/// `attempted` means the HTTP result was classified.
enum ExternalWebhookAttemptState {
  recorded
  sending
  attempted
}

/// Terminal or retry classification for one external webhook POST.
/// `http_accepted` is a 2xx only. It is not a GHL contact, workflow, or note receipt.
enum ExternalWebhookDeliveryOutcome {
  http_accepted
  retryable
  failed
  uncertain
}

/// `v3_canonical` uses the company Sheets v3 source fields.
/// `published_column_map` freezes one already-published funnel or shared map.
enum ExternalWebhookMappingMode {
  v3_canonical
  published_column_map
}

/// Same words as the customer release notifier. Do not add synonyms.
enum DeliverySuccessNotificationStatus {
  pending
  sending
  sent
  skipped
  failed
}

/// One outbound custom webhook destination per client account.
/// The signing secret is AES-256-GCM ciphertext under SA360_CUSTOM_WEBHOOK_SECRET_KEY.
/// Plaintext and ciphertext never belong in DeliveryTarget.configMetadataJson, logs, or tickets.
/// enabled defaults to false. Creating this row does not set DeliveryTarget.enabled
/// and does not send a webhook. There is no relation that cascades a send.
model ClientCustomWebhookDestination {
  id                       String          @id @default(cuid())
  clientAccountId          String          @unique
  clientAccount            ClientAccount   @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  /// Optional webhook.generic.v1 target. Unique when set. SetNull does not send.
  deliveryTargetId         String?         @unique
  deliveryTarget           DeliveryTarget? @relation(fields: [deliveryTargetId], references: [id], onDelete: SetNull)
  endpointUrl              String
  /// AES-256-GCM ciphertext (`iv.tag.ciphertext`, base64url). Server-side only.
  signingSecretCiphertext  String
  /// SHA-256 prefix of the plaintext secret. Not itself a secret.
  signingSecretFingerprint String
  enabled                  Boolean         @default(false)
  revision                 Int             @default(1)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
}

/// One fresh-lead external webhook per client. This is the third delivery
/// destination: a client-owned GHL inbound webhook URL, or a Make/custom HTTPS
/// endpoint. It is not ClientCustomWebhookDestination and it has no DeliveryTarget.
///
/// The endpoint URL and the optional HMAC secret are AES-256-GCM ciphertext
/// under SA360_EXTERNAL_WEBHOOK_CREDENTIAL_KEY. That key is not the Meta, GHL,
/// Google, or legacy custom-webhook key. Plaintext and ciphertext never belong
/// in logs, tickets, or DeliveryTarget.configMetadataJson. endpointHost is the
/// hostname only.
///
/// enabled defaults to false. crmRole is always primary_crm. SQL rejects
/// enabled=true while ClientGhlDestination is armed for live location delivery
/// on the same client, and rejects arming that GHL row while this row is
/// enabled. Company Sheets is not part of that check. Creating this row does
/// not set DeliveryTarget.enabled, ClientGhlDestination.deliveryEnabled, or
/// CompanySheetsDestination.campaignDispatchEnabled.
model ClientExternalWebhookDestination {
  id                          String                         @id @default(cuid())
  clientAccountId             String                         @unique
  clientAccount               ClientAccount                  @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  kind                        ExternalWebhookDestinationKind
  /// Always primary_crm. Sheets is not stored here.
  crmRole                     String                         @default("primary_crm")
  authMode                    ExternalWebhookAuthMode        @default(none)
  /// AES-256-GCM ciphertext of the canonical HTTPS URL (`iv.tag.ciphertext`, base64url).
  endpointUrlCiphertext       String
  /// SHA-256 prefix of the canonical URL. Not reversible to the path or query.
  endpointUrlFingerprint      String
  /// Hostname only. No userinfo, port, path, or query.
  endpointHost                String
  /// AES-256-GCM ciphertext of the optional HMAC secret. Null when authMode is none.
  signingSecretCiphertext     String?
  /// SHA-256 prefix of the HMAC secret. Null when authMode is none. Not itself a secret.
  signingSecretFingerprint    String?
  enabled                     Boolean                        @default(false)
  /// Optimistic token. A URL or secret change must advance it. Open attempts keep the old revision.
  revision                    Int                            @default(1)
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  attempts                    ExternalWebhookDeliveryAttempt[]

  @@index([enabled])
}

/// Frozen outbound receipt for one client and one source lead.
/// idempotencyKey is external-webhook:{clientAccountId}:{sourceLeadEventId}.
/// payloadCanonicalJson and the mapping columns are immutable after insert.
/// A later sender may set state, outcome, httpStatus, and requestLeftSa360 only.
/// This row does not write GhlLiveDeliveryRun, a Sheets job, or an onboarding-test key.
/// ON DELETE RESTRICT: client or destination deletion must not erase the receipt.
/// sourceLeadEventId is not a foreign key.
model ExternalWebhookDeliveryAttempt {
  id                      String                           @id @default(cuid())
  idempotencyKey          String                           @unique
  clientAccountId         String
  clientAccount           ClientAccount                    @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Restrict)
  destinationId           String
  destination             ClientExternalWebhookDestination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  sourceLeadEventId       String
  kind                    ExternalWebhookDestinationKind
  /// Destination.revision copied at insert. A later URL revision does not retarget this row.
  destinationRevision     Int
  endpointHost            String
  endpointUrlFingerprint  String
  mappingMode             ExternalWebhookMappingMode
  columnMapId             String?
  columnMapVersion        Int?
  /// column-map:{id}:v{version} when a published map is frozen. Null for v3.
  columnMapContentKey     String?
  columnMapSourceScope    String?
  /// Exact UTF-8 JSON the later sender must POST. Retries send these bytes.
  payloadCanonicalJson    String
  /// Lowercase hex SHA-256 of payloadCanonicalJson.
  payloadSha256           String
  state                   ExternalWebhookAttemptState      @default(recorded)
  outcome                 ExternalWebhookDeliveryOutcome?
  httpStatus              Int?
  /// True only after the request bytes left this process. Timeout and 3xx stay true and are not retried.
  requestLeftSa360        Boolean                          @default(false)
  proves                  Json                             @default("[]")
  doesNotProve            Json                             @default("[\"ghl_contact\",\"ghl_workflow\",\"ghl_note\",\"ghl_location_api_success\",\"sheets_row_appended\",\"sms_sent\",\"email_sent\"]")
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt

  @@unique([clientAccountId, sourceLeadEventId], map: "ExternalWebhookDeliveryAttempt_client_event_key")
  @@index([state, createdAt])
  @@index([destinationId])
}

/// Per-client on/off choice for a successful-delivery email.
/// enabled defaults false. SQL check ClientDeliveryNotifyPref_enabled_verified_chk
/// rejects enabled=true unless recipientEmail, recipientEmailVerifiedAt, and
/// enabledAt are present and channel is email.
/// ClientDeliveryNotifyPref_sms_verified_chk rejects smsEnabled=true unless
/// recipientPhoneE164 and recipientPhoneVerifiedAt are present.
/// ClientDeliveryNotifyPref_phone_e164_chk requires E.164 when a phone is stored.
/// Channel stays email. Deleting the client cascades this configuration and does
/// not send. This row does not arm GHL, Sheets, or webhooks.
model ClientDeliveryNotificationPreference {
  id                        String                            @id @default(cuid())
  clientAccountId           String                            @unique
  clientAccount             ClientAccount                     @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  enabled                   Boolean                           @default(false)
  channel                   ClientDeliveryNotificationChannel @default(email)
  /// One lowercase mailbox. Null until an admin records it. Not portalLoginEmail.
  recipientEmail            String?
  /// Set in the same admin save that records the address. Not a verification message.
  recipientEmailVerifiedAt  DateTime?
  /// Optional verified mobile for a later SMS sender. Null until an admin records it.
  /// This is the operator's phone, not the consumer's. Storing it does not send.
  recipientPhoneE164        String?
  /// Set in the same admin save that records the E.164. Not an SMS.
  recipientPhoneVerifiedAt  DateTime?
  /// Stored on/off for that later sender. Default off. Channel stays email.
  smsEnabled                Boolean                           @default(false)
  /// Transaction time of the latest off-to-on transition. Never moves backward.
  /// Receipts at or before this instant are not notified. Null while never enabled.
  enabledAt                 DateTime?
  disabledAt                DateTime?
  /// Optimistic token. A client with no row is revision 0. The config routes advance it.
  revision                  Int                               @default(1)
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
}

/// One accepted Admin C.O.C. write of a notification recipient or on/off choice.
/// requestId is the idempotency key. A repeat of the same id and payload returns
/// the stored result. A different payload for that id conflicts. Deleting the
/// client cascades these rows and does not send. This is not a notification receipt.
model ClientDeliveryNotificationConfigRequest {
  id              String        @id @default(cuid())
  requestId       String        @unique
  clientAccountId String
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  /// recipient | preference
  action          String
  payloadHash     String
  /// Stored response for an exact replay. The recipient snapshot includes the mailbox.
  resultJson      Json
  createdAt       DateTime      @default(now())

  @@index([clientAccountId, createdAt])
}

/// Proposed client-source and campaign association.
/// Status is only requested, rejected, or superseded. There is no approved status.
/// This is not a SourceFunnel, not a CampaignRoutingRule, and not a delivery arm.
/// Routing, inventory origin, and delivery queries must not read this table.
///
/// One open proposal per client is the partial unique index
/// SourceCampaignAssociationRequest_one_requested_key
/// on (clientAccountId) WHERE status = 'requested'.
/// Prisma 6 cannot model that filter. Do not drop the index in a later diff.
///
/// SQL checks and the snapshot trigger reject identifier edits, a return to
/// requested, and an insert that is already superseded. Do not drop those.
enum SourceCampaignAssociationRequestStatus {
  requested
  rejected
  superseded
}

model SourceCampaignAssociationRequest {
  id                        String                                  @id @default(cuid())
  /// Idempotency key for the record command. A repeat returns the stored result.
  requestId                 String                                  @unique
  clientAccountId           String
  clientAccount             ClientAccount                           @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Restrict, onUpdate: Restrict)
  /// Client id at insert. A later rename does not rewrite it.
  historicalClientAccountId String
  /// Request-chain token the caller loaded. 0 when the client had no row yet.
  expectedRevision          Int
  /// Monotonic per client. The highest value is the next expectedRevision.
  revision                  Int
  /// ClientOnboardingSetup.revision observed under the row lock.
  setupRevision             Int
  providerFunnelId          String?
  parentUrlKey              String?
  providerCampaignId        String
  status                    SourceCampaignAssociationRequestStatus
  payloadHash               String
  /// Immutable result of the record command.
  recordResultJson          Json
  /// ADMIN for the shared admin key. A named staff write stores StaffPrincipal.id.
  /// Set from a verified staff assertion. Not a role, email, or browser label.
  actor                     String
  dispositionReason         String?
  /// Idempotency key for a later operator rejection. Null until that command.
  rejectionRequestId        String?                                 @unique
  rejectionPayloadHash      String?
  rejectionResultJson       Json?
  supersededByRequestId     String?
  rejectedAt                DateTime?
  supersededAt              DateTime?
  createdAt                 DateTime                                @default(now())
  updatedAt                 DateTime                                @updatedAt

  @@unique([clientAccountId, revision])
  @@index([clientAccountId, createdAt])
}

/// Intended GoHighLevel location, workflow id, and exact field ids.
