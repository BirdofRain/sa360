/// Tenant-bound Google OAuth connection. Tokens never live on ClientAccount or DeliveryTarget.
///
/// Active-identity uniqueness is a SQL partial unique index
/// (`GoogleAccountConnection_googleUserId_active_key`: googleUserId WHERE status IN
/// connected / reconnect_required / error AND googleUserId IS NOT NULL). Prisma 6 cannot
/// express filtered unique indexes as @@unique. Do **not** add @@unique([googleUserId]) —
/// that would prevent a disconnected identity from being connected by another tenant.
/// `prisma migrate diff` / `migrate dev` may propose DROP INDEX for this; reject that.
enum GoogleAccountConnectionStatus {
  connected
  reconnect_required
  disconnected
  error
}

model GoogleAccountConnection {
  id                      String                        @id @default(cuid())
  clientAccountId         String                          @unique
  clientAccount           ClientAccount                 @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  /// Google OpenID `sub`. Audit identity. Not a tenant-scoped secret lookup key.
  googleUserId            String?
  googleEmail             String?
  googleDisplayName       String?
  /// Neutral default so a generic create cannot look "connected" without credentials.
  /// The upsert service always sets `connected` together with encrypted tokens.
  status                  GoogleAccountConnectionStatus @default(disconnected)
  accessTokenEncrypted    String?
  refreshTokenEncrypted   String?
  tokenExpiresAt          DateTime?
  scopes                  Json?
  tokenType               String?
  /// Compare-and-set refresh generation. Conditional updates must match this value.
  tokenVersion            Int                           @default(1)
  connectedAt             DateTime?
  lastRefreshedAt         DateTime?
  reconnectRequiredAt     DateTime?
  disconnectedAt          DateTime?
  lastError               String?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  @@index([status, updatedAt])
  @@index([googleUserId])
}

/// Short-lived, one-time Google OAuth start state (PKCE + CSRF). Callback consumes once.
model GoogleOAuthPendingAuth {
  id                     String        @id @default(cuid())
  clientAccountId        String
  clientAccount          ClientAccount @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  /// SHA-256 hex of the opaque OAuth `state` value. Raw state is never persisted.
  stateHash              String        @unique
  pkceVerifierEncrypted  String
  /// Allowlisted internal `/portal` path only.
  returnTo               String
  expiresAt              DateTime
  consumedAt             DateTime?
  createdAt              DateTime      @default(now())

  @@index([clientAccountId, expiresAt])
  @@index([consumedAt, expiresAt])
}

/// Life Agent Launch's Google account. Not a per-client OAuth connection.
/// Tokens use the same Google encryption helper as GoogleAccountConnection.
///
/// Active-identity uniqueness is a SQL partial unique index
/// (`CompanyGoogleConnection_googleUserId_active_key`: googleUserId WHERE status IN
/// connected / reconnect_required / error AND googleUserId IS NOT NULL). Prisma 6
/// cannot express filtered unique indexes as @@unique. Do not add
/// @@unique([googleUserId]). `prisma migrate diff` may propose DROP INDEX; reject that.
model CompanyGoogleConnection {
  id                          String                        @id @default(cuid())
  /// Singleton key. Exactly one Life Agent Launch connection.
  connectionKey               String                        @unique @default("life_agent_launch")
  googleUserId                String?
  googleEmail                 String?
  googleDisplayName           String?
  status                      GoogleAccountConnectionStatus @default(disconnected)
  accessTokenEncrypted        String?
  refreshTokenEncrypted       String?
  tokenExpiresAt              DateTime?
  scopes                      Json?
  tokenType                   String?
  /// Compare-and-set refresh generation. Conditional updates must match this value.
  tokenVersion                Int                           @default(1)
  connectedAt                 DateTime?
  lastRefreshedAt             DateTime?
  reconnectRequiredAt         DateTime?
  disconnectedAt              DateTime?
  lastError                   String?
  /// Approved Drive folder for new client spreadsheets. Verified server-side.
  destinationFolderId         String?
  destinationFolderTitle      String?
  destinationFolderVerifiedAt DateTime?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  spreadsheetCreations CompanySpreadsheetCreation[]
  destinations         CompanySheetsDestination[]

  @@index([status, updatedAt])
  @@index([googleUserId])
}

/// Short-lived admin OAuth start state for the company Google account.
model CompanyGoogleOAuthPendingAuth {
  id                    String    @id @default(cuid())
  /// SHA-256 hex of the opaque OAuth `state` value. Raw state is never persisted.
  stateHash             String    @unique
  pkceVerifierEncrypted String
  /// Allowlisted internal admin path only. Never a portal or external URL.
  returnTo              String
  initiatedBy           String?
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([consumedAt, expiresAt])
}

/// Server-side proof that this API created the spreadsheet with the company token.
/// A browser-supplied ownership boolean is never stored and never accepted.
model CompanySpreadsheetCreation {
  id                  String                  @id @default(cuid())
  companyConnectionId String
  companyConnection   CompanyGoogleConnection @relation(fields: [companyConnectionId], references: [id], onDelete: Restrict)
  spreadsheetId       String                  @unique
  spreadsheetTitle    String
  spreadsheetUrl      String
  worksheetId         Int
  worksheetTitle      String
  folderId            String?
  /// placed. Historical rows may still say root_unconfigured, placement_failed, placement_unavailable_missing_scope, or not_requested. New creates do not use Drive root.
  folderPlacement     String
  createdByActor      String?
  createdAt           DateTime                @default(now())

  destination CompanySheetsDestination?

  @@index([companyConnectionId, createdAt])
}

/// Current Drive folder associated with one client.
/// Clearing the link sets status to unlinked and keeps folderId so the folder stays discoverable.
/// Display names are not unique. folderId is the durable identity.
model CompanySheetsClientFolder {
  clientAccountId String        @id
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  folderId        String?
  folderTitle     String        @default("")
  /// active | unlinked | creating | unknown
  status          String        @default("creating")
  operationToken  String?
  linkedAt        DateTime?
  unlinkedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([folderId])
  @@index([status, updatedAt])
}

/// Append-only folder link history. Unlink does not delete these rows or the Drive folder.
model CompanySheetsFolderEvent {
  id              String        @id @default(cuid())
  clientAccountId String
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  folderId        String
  folderTitle     String
  /// created | linked | unlinked
  action          String
  createdAt       DateTime      @default(now())

  @@index([clientAccountId, createdAt])
}

/// Destination saves recorded from this release forward. Earlier destinations are not backfilled.
model CompanySheetsSpreadsheetLink {
  id               String    @id @default(cuid())
  clientAccountId  String
  clientAccount    ClientAccount @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  spreadsheetId    String
  spreadsheetTitle String?
  spreadsheetUrl   String
  /// current | previous
  status           String
  recordedAt       DateTime  @default(now())
  supersededAt     DateTime?

  @@index([clientAccountId, recordedAt])
  @@index([spreadsheetId])
}

/// Company-managed spreadsheet destination for one client.
///
/// Configuration only. `enabled` stays false and `deliveryExecution` stays
/// `disabled` until a later execution canary. This row is not a DeliveryTarget
/// and must not enter LF2 planning. One destination per client and one client
/// per spreadsheet are real unique keys, so a sheet cannot be shared across clients.
model CompanySheetsDestination {
  id                           String                      @id @default(cuid())
  clientAccountId              String                      @unique
  clientAccount                ClientAccount               @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  companyConnectionId          String
  companyConnection            CompanyGoogleConnection     @relation(fields: [companyConnectionId], references: [id], onDelete: Restrict)
  spreadsheetId                String                      @unique
  spreadsheetTitle             String?
  spreadsheetUrl               String
  worksheetId                  Int
  worksheetTitle               String
  /// company_created | drive_owner_verified | approved_shared_drive. Server-derived only.
  controlBasis                 String
  companySpreadsheetCreationId String?                     @unique
  companySpreadsheetCreation   CompanySpreadsheetCreation? @relation(fields: [companySpreadsheetCreationId], references: [id], onDelete: SetNull)
  /// not_checked | readable | denied | unavailable | reconnect_required
  accessStatus                 String                      @default("not_checked")
  accessCheckedAt              DateTime?
  /// not_verified. A delivery job does not promote this field.
  writeReadiness               String                      @default("not_verified")
  /// disabled. Job execution is a separate flag and does not flip this field.
  deliveryExecution            String                      @default("disabled")
  /// missing_recipient | intended_recipient_recorded_not_applied
  sharingStatus                String
  intendedRecipientEmail       String?
  enabled                      Boolean                     @default(false)
  /// Admin approval for synthetic canary rows. Default false. Never implies client delivery.
  canaryApproved               Boolean                     @default(false)
  /// Automatic campaign scheduling. Default off. Does not replay leads from before the cutoff.
  campaignDispatchEnabled      Boolean                     @default(false)
  campaignDispatchNotBefore    DateTime?
  /// Automatic aged scheduling. Default off. A release that precedes setup is not replayed.
  agedDispatchEnabled          Boolean                     @default(false)
  agedDispatchNotBefore        DateTime?
  /// Monotonic snapshot generation. Jobs copy it at enqueue and do not follow later edits.
  destinationRevision          Int                         @default(1)
  createdByActor               String?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt

  deliveryJobs CompanySheetsDeliveryJob[]
  tabContracts CompanySheetsTabContract[]

  @@index([companyConnectionId])
  @@index([accessStatus])
}

/// One delivery contract on the client's company spreadsheet.
/// Campaign and aged are separate tabs. Canary exists only on an approved test spreadsheet.
/// Status reads do not create or rename tabs.
model CompanySheetsTabContract {
  id              String                   @id @default(cuid())
  destinationId   String
  destination     CompanySheetsDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  /// campaign | aged | canary
  role            String
  /// missing | incompatible | bound | creating
  setupState      String                   @default("missing")
  setupReason     String?
  worksheetId     Int?
  worksheetTitle  String?
  schemaVersion   String?
  headerContract  Json?
  inspectedAt     DateTime?
  boundAt         DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([destinationId, role], map: "CompanySheetsTab_destination_role_key")
  @@index([destinationId, setupState], map: "CompanySheetsTab_destination_state_idx")
}

/// Immutable company Sheets delivery job. Destination columns are a snapshot.
/// Later edits to CompanySheetsDestination must not change this row's target.
model CompanySheetsDeliveryJob {
  id                   String    @id @default(cuid())
  /// lead | aged_release | canary | campaign_test | onboarding_captured_test
  kind                 String
  /// queued | running | succeeded | retryable | uncertain
  status               String
  clientAccountId      String
  companyConnectionId  String
  destinationId        String?
  destination          CompanySheetsDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  spreadsheetId        String
  spreadsheetUrl       String
  worksheetId          Int
  worksheetTitle       String
  controlBasis         String
  /// CompanySheetsDestination.updatedAt captured at enqueue.
  destinationUpdatedAt DateTime
  headerContract       Json
  schemaVersion        String    @default("")
  destinationRevision  Int       @default(1)
  /// Set immediately before an append request. A missing sheet row does not clear it.
  appendStartedAt      DateTime?
  sourceLeadEventId    String?
  leadOrderId          String?
  exportPackageId      String?
  contentSha256        String?
  idempotencyKey       String    @unique
  rowsTotal            Int
  rowsWritten          Int       @default(0)
  attemptCount         Int       @default(0)
  lastError            String?
  uncertainReason      String?
  claimToken           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  startedAt            DateTime?
  finishedAt           DateTime?

  rows          CompanySheetsDeliveryRow[]
  orderEvidence CompanySheetsOrderDeliveryEvidence?

  @@index([status, updatedAt])
  @@index([clientAccountId, createdAt])
  @@index([spreadsheetId, worksheetId, status])
  @@index([leadOrderId])
  @@index([exportPackageId])
}

/// One logical output row. stableRowId is unique per worksheet so retries cannot duplicate it.
model CompanySheetsDeliveryRow {
  id            String   @id @default(cuid())
  jobId         String
  job           CompanySheetsDeliveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  spreadsheetId String
  worksheetId   Int
  stableRowId   String
  ordinal       Int
  valuesJson    Json
  /// pending | written
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([jobId, ordinal])
  @@unique([spreadsheetId, worksheetId, stableRowId], map: "CompanySheetsRow_sheet_stable_key")
  @@index([jobId, status])
}

/// Serializes appends to one worksheet. One owner job at a time.
model CompanySheetsWorksheetLock {
  spreadsheetId String
  worksheetId   Int
  ownerJobId    String?
  lockedAt      DateTime?

  @@id([spreadsheetId, worksheetId])
}

/// Order-specific Sheets evidence. Independent of spreadsheetDeliveredAt and of the client's current destination.
model CompanySheetsOrderDeliveryEvidence {
  id              String   @id @default(cuid())
  leadOrderId     String
  exportPackageId String   @unique
  clientAccountId String
  jobId           String   @unique
  job             CompanySheetsDeliveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  spreadsheetId   String
  spreadsheetUrl  String
  worksheetId     Int
  worksheetTitle  String
  /// Mirrors the job status at the last enqueue or execute. Not spreadsheetDeliveredAt.
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([leadOrderId, clientAccountId], map: "CompanySheetsEvidence_order_client_idx")
}

/// Durable schedule for one campaign lead or aged release.
/// Campaign intents commit with confirmed routing. Aged intents commit with Approve & Release. Execution is separate.
model CompanySheetsDispatchIntent {
  id                String    @id @default(cuid())
  idempotencyKey    String    @unique
  /// campaign_lead | aged_release
  kind              String
  /// pending | awaiting_setup | needs_explicit_schedule | processing | scheduled | retryable | completed | duplicate_held | review_held | assessment_held | assessment_failed
  status            String
  clientAccountId   String
  sourceLeadEventId String?
  exportPackageId   String?
  leadOrderId       String?
  jobId             String?
  reason            String?
  explicit          Boolean   @default(false)
  actor             String?
  availableAt       DateTime  @default(now())
  attemptCount      Int       @default(0)
  lastError         String?
  processingAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, availableAt], map: "CompanySheetsDispatch_status_available_idx")
  @@index([clientAccountId, kind], map: "CompanySheetsDispatch_client_kind_idx")
  @@index([exportPackageId], map: "CompanySheetsDispatch_export_idx")
  @@index([sourceLeadEventId], map: "CompanySheetsDispatch_lead_idx")
}

/// A routing dry-run whose duplicate-risk evaluation threw.
/// A persisted LeadDuplicateRiskAssessment outranks this row. Routing itself is not failed.
/// failureClass transient is retried by the Sheets drain. review waits for an operator.
model DuplicateRiskAssessmentFailure {
  routingDryRunDecisionId String   @id
  errorName               String
  /// transient | review
  failureClass            String   @default("review")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

/// Client-scoped person slot for Sheets delivery. Not a tab, not a GHL receipt, not an event id.
/// One normalized phone or email is reserved for one owner inside one client.
model ClientSheetsPersonAdmission {
  id                  String   @id @default(cuid())
  clientAccountId     String
  /// phone | email
  kind                String
  normalizedValue     String
  fingerprint         String
  sourceLeadEventId   String?
  /// zap:{client}:{importKey} for a verified historical baseline. Null for a live reservation.
  historicalImportKey String?
  /// reserved | admitted
  status              String
  policy              String
  /// live_reservation | historical_baseline | delivery_index
  origin              String
  evidenceJson        Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([clientAccountId, kind, normalizedValue], map: "ClientSheetsPersonAdmission_client_identifier_key")
  @@index([clientAccountId, sourceLeadEventId], map: "ClientSheetsPersonAdmission_client_event_idx")
  @@index([historicalImportKey], map: "ClientSheetsPersonAdmission_import_key_idx")
}

/// One Sheets person-gate outcome. Distinct from the event idempotency key and from channel receipts.
model ClientSheetsDedupeDecision {
  id                 String   @id @default(cuid())
  idempotencyKey     String   @unique
  clientAccountId    String
  sourceLeadEventId  String?
  /// sheets. This row is not a Sheets append receipt and not a GHL receipt.
  channel            String   @default("sheets")
  outcome            String
  policy             String
  reason             String
  normalizedPhone    String?
  normalizedEmail    String?
  /// present | missing | failed | not_applicable | exempt
  assessmentState    String
  priorEvidenceJson  Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([clientAccountId, outcome], map: "ClientSheetsDedupeDecision_client_outcome_idx")
  @@index([sourceLeadEventId], map: "ClientSheetsDedupeDecision_event_idx")
}

/// How much of this client's lead-job history is represented in ClientSheetsPersonAdmission.
/// status is the completeness proof. indexedCount and observedJobCount are not.
model ClientSheetsHistoryCoverage {
  clientAccountId String    @id
  /// unavailable | partial | complete
  status          String
  /// cursor_exhausted | no_eligible_jobs | cursor_open | not_started
  completenessProof String
  cursorCreatedAt DateTime?
  cursorJobId     String?
  indexedCount    Int       @default(0)
  observedJobCount Int      @default(0)
  updatedAt       DateTime  @updatedAt
}

/// Audit copy of a live reservation released because the send never reached Google.
model ClientSheetsPersonRelease {
  id                String   @id @default(cuid())
  clientAccountId   String
  kind              String
  normalizedValue   String
  fingerprint       String
  sourceLeadEventId String?
  admissionId       String
  policy            String
  reason            String
  actor             String?
  evidenceJson      Json?
  releasedAt        DateTime @default(now())

  @@index([clientAccountId, normalizedValue], map: "ClientSheetsPersonRelease_client_value_idx")
  @@index([sourceLeadEventId], map: "ClientSheetsPersonRelease_event_idx")
}

/// Schedule row for association GHL delivery, committed with intake.
/// Pending rows can be recovered before an attempt starts.
/// A crash after the attempt is claimed is uncertain and is not sent again.
/// An executing live run is not sent again. This does not finish an in-flight call.
model GhlAssociationDispatchOutbox {
  id                       String    @id @default(cuid())
  idempotencyKey           String    @unique
  /// pending | executing | settled | uncertain
  status                   String
  clientAccountId          String
  sourceLeadEventId        String
  routingDryRunDecisionId  String?
  destinationLocationIdGhl String
  liveRunId                String?
  outcome                  String?
  externalCallExecuted     Boolean   @default(false)
  attemptCount             Int       @default(0)
  availableAt              DateTime
  executingAt              DateTime?
  settledAt                DateTime?
  lastError                String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([status, availableAt], map: "GhlAssociationDispatch_status_available_idx")
  @@index([sourceLeadEventId], map: "GhlAssociationDispatch_lead_idx")
}

/// Read-only GHL config discovery snapshot per location (Phase 5B).
model GhlLocationConfigSnapshot {
  id               String   @id @default(cuid())
  locationId       String
  clientAccountId  String?
  fetchedAt        DateTime
  locationName     String?
  locationJson     Json?
  pipelinesJson    Json?
  workflowsJson    Json?
  usersJson        Json?
  customFieldsJson Json?
  tagsJson         Json?
  errorsJson       Json?
  warningsJson     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([locationId, fetchedAt])
  @@index([clientAccountId, fetchedAt])
}

/// Internal support tickets filed from Admin C.O.C. (Phase: support v1).
model SupportTicket {
  id           String @id @default(cuid())
  ticketNumber Int    @unique @default(autoincrement())

  source   String @default("admin_coc")
  status   String @default("OPEN")
  priority String @default("NORMAL")
  category String @default("GENERAL")

  subject     String?
  description String

  requesterName   String?
  requesterEmail  String?
  requesterUserId String?

  assignedToName   String?
  assignedToUserId String?

  clientAccountId       String?
  masterClientAccountId String?
  subaccountIdGhl       String?
  relatedEntityType     String?
  relatedEntityId       String?

  pagePath    String?
  pageUrl     String?
  queryJson   Json?
  contextJson Json?
  userAgent   String?

  internalNotes     Json?
  resolutionSummary String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@index([status, createdAt])
  @@index([priority, createdAt])
  @@index([category, createdAt])
  @@index([clientAccountId])
  @@index([masterClientAccountId])
  @@index([subaccountIdGhl])
  @@index([relatedEntityType, relatedEntityId])
}

/// Global runtime delivery adapter mode (admin-toggleable; env sets max capability).
model DeliveryRuntimeModeSetting {
  id                     String    @id @default("default")
  configuredRuntimeMode  String    @default("simulate")
  liveCanaryEnabledUntil DateTime?
  enabledBy              String?
  enabledAt              DateTime?
  reason                 String?
  lastChangedAt          DateTime  @updatedAt
  createdAt              DateTime  @default(now())
}

/// Audit trail for delivery runtime mode changes and live canary outcomes.
model DeliveryRuntimeModeAuditEvent {
  id                     String    @id @default(cuid())
  eventType              String
  previousMode           String?
  newMode                String?
  effectiveMode          String?
  maxAllowedMode         String?
  reason                 String?
  enabledBy              String?
  liveCanaryEnabledUntil DateTime?
  metadataJson           Json?
  createdAt              DateTime  @default(now())

  @@index([eventType, createdAt])
}

enum AdminRuntimeSettingScope {
  GLOBAL
  CLIENT
  SUBACCOUNT
}

enum AdminRuntimeSettingEnvironment {
  STAGING
  PRODUCTION
}

/// Operator-toggleable runtime control settings (delivery mode, routing mode, etc.).
/// NEVER stores secrets — secrets always remain in environment variables.
/// Resolution order is SUBACCOUNT > CLIENT > GLOBAL > env fallback > safe default.
model AdminRuntimeSetting {
  id              String                         @id @default(cuid())
  key             String
  value           Json
  scope           AdminRuntimeSettingScope       @default(GLOBAL)
  clientAccountId String?
  subaccountIdGhl String?
  environment     AdminRuntimeSettingEnvironment @default(STAGING)
  description     String?
  reason          String?
  isSensitive     Boolean                        @default(false)
  isEditable      Boolean                        @default(true)
  updatedBy       String?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@unique([key, scope, environment, clientAccountId, subaccountIdGhl])
  @@index([key])
  @@index([scope])
  @@index([environment])
  @@index([clientAccountId])
  @@index([subaccountIdGhl])
}

/// Raw inbound lead from external sources (LeadCapture.io, vendors, imports) before operator approval.
model SourceLeadEvent {
  id                            String                @id @default(cuid())
  sourceProvider                SourceLeadProvider
  sourceSystem                  SourceLeadSystem
  sourceType                    SourceLeadType
  sourceRouteKey                String?
  sourceCampaignId              String?
  sourceCampaignName            String?
  sourceFunnelName              String?
  sourceLeadId                  String?
  sourceLeadUid                 String?
  clientAccountIdResolved       String?
  destinationLocationIdResolved String?
  routingRuleIdResolved         String?
  status                        SourceLeadEventStatus @default(received)
  rawPayloadJson                Json
  normalizedPayloadJson         Json?
  routingResultJson             Json?
  duplicateRiskJson             Json?
  deliveryResultJson            Json?
  /// Intake/enrichment/automation metadata (intakeStatus, enrichmentStatus, sourceAttributes, etc.).
  enrichmentMetadataJson        Json?
  routingDryRunDecisionId       String?
  errorSummary                  String?
  webhookRequestLogId           String?
  receivedAt                    DateTime              @default(now())
  normalizedAt                  DateTime?
  routedAt                      DateTime?
  approvedAt                    DateTime?
  deliveredAt                   DateTime?
  approvedBy                    String?
  bulkImportId                  String?
  bulkImportRowId               String?
  cleanupStatus                 String?
  cleanupReason                 String?
  cleanupMarkedAt               DateTime?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt

  eligibilityAssessments LeadEligibilityAssessment[]
  fulfillmentOutboxItems FulfillmentOutbox[]
  leadAllocations        LeadAllocation[]
  leadInventoryItem      LeadInventoryItem?
  onboardingTestRuns     ClientOnboardingTestRun[]

  @@index([receivedAt])
  @@index([status, receivedAt])
  @@index([sourceProvider, receivedAt])
  @@index([sourceSystem, receivedAt])
  @@index([sourceRouteKey])
  @@index([clientAccountIdResolved])
  @@index([webhookRequestLogId])
  @@index([bulkImportId])
  @@index([cleanupStatus, receivedAt])
  @@index([sourceProvider, sourceSystem, sourceLeadId])
  @@index([sourceProvider, sourceCampaignId])
}

/// Last-known incoming field key set per source route for schema drift detection.
model SourceRouteSchemaSnapshot {
  id                String   @id @default(cuid())
  sourceProvider    String
  sourceRouteKey    String
  fieldKeysJson     Json
  schemaFingerprint String
  lastSeenAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([sourceProvider, sourceRouteKey])
  @@index([sourceProvider, sourceRouteKey])
}

/// Operator CSV / future sheet bulk lead import batch.
