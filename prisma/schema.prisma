/// Operator-managed client tenant profile (portal + onboarding).
model ClientAccount {
  clientAccountId     String              @id
  clientDisplayName   String
  status              ClientAccountStatus @default(onboarding)
  portalEnabled       Boolean             @default(false)
  portalDisplayName   String?
  /// Portal login email (case-insensitive match at sign-in).
  portalLoginEmail    String?             @unique
  /// Per-customer portal password (encoded scrypt). Null = env-password migration fallback.
  portalPasswordHash  String?
  portalPasswordSetAt DateTime?
  /// Increment to revoke previously issued portal sessions for this account.
  portalSessionEpoch  Int                 @default(0)
  /// SHA-256 hex of the outstanding one-time portal invite token. Never store the raw token.
  portalInviteTokenHash String?           @unique
  /// When the outstanding invite expires (48 hours from issuance).
  portalInviteExpiresAt DateTime?
  primaryNicheKeys    Json                @default("[]")
  primaryProductTypes Json                @default("[]")
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  ghlDestination  ClientGhlDestination?
  routingRules    CampaignRoutingRule[]
  deliveryTargets DeliveryTarget[]
  googleAccountConnection GoogleAccountConnection?
  googleOAuthPendingAuths GoogleOAuthPendingAuth[]
  /// Company-managed Sheets binding. Configuration only; not a client OAuth connection.
  companySheetsDestination CompanySheetsDestination?
  /// Current client folder pointer. Unlink keeps the folder id.
  companySheetsClientFolder CompanySheetsClientFolder?
  companySheetsFolderEvents CompanySheetsFolderEvent[]
  companySheetsSpreadsheetLinks CompanySheetsSpreadsheetLink[]
  suggestedSourceFunnels SourceFunnel[] @relation("SourceFunnelSuggestedClient")
  originSourceFunnels    SourceFunnel[] @relation("SourceFunnelOriginClient")
  originInventoryItems   LeadInventoryItem[] @relation("LeadInventoryOriginClient")
  onboardingSetup        ClientOnboardingSetup?
  /// Onboarding v2 configuration. Not a delivery switch and not a credential store.
  onboardingDestinationProfile ClientOnboardingDestinationProfile?
  onboardingVerifiedTestIdentities ClientOnboardingVerifiedTestIdentity[]
  onboardingTestWorksheet ClientOnboardingTestWorksheet?
  onboardingTestRuns ClientOnboardingTestRun[]
  onboardingSheetColumnMaps ClientSheetColumnMap[]
  onboardingActivationIntents ClientOnboardingActivationIntent[]
  /// Historical July-label alias rows whose confirmed origin is this client.
  /// Portal reads do not include this relation.
  historicalCampaignAliases HistoricalCampaignAlias[] @relation("HistoricalCampaignAliasOrigin")
  historicalAliasPreviousOriginEvents HistoricalCampaignAliasEvent[] @relation("HistoricalCampaignAliasEventPreviousOrigin")
  historicalAliasNextOriginEvents HistoricalCampaignAliasEvent[] @relation("HistoricalCampaignAliasEventNextOrigin")
  /// Outbound custom webhook configuration. enabled defaults false and does not arm delivery.
  customWebhookDestination ClientCustomWebhookDestination?
  /// Fresh-lead external webhook. One primary CRM destination per client.
  /// enabled defaults false. Creating the row does not arm GHL, Sheets, or the legacy webhook.
  externalWebhookDestination ClientExternalWebhookDestination?
  /// Frozen external-webhook receipts. Restrict so account deletion cannot erase them.
  externalWebhookDeliveryAttempts ExternalWebhookDeliveryAttempt[]
  /// Per-client notification on/off choice. Defaults disabled and cascades without sending.
  deliveryNotificationPreference ClientDeliveryNotificationPreference?
  /// Accepted recipient and on/off writes. Cascade with the client. These rows do not send.
  deliveryNotificationConfigRequests ClientDeliveryNotificationConfigRequest[]
  /// Proposed source and campaign associations. Restrict so account deletion cannot erase them.
  /// Not a source confirmation and not a routing rule.
  sourceCampaignAssociationRequests SourceCampaignAssociationRequest[]
  /// Intended GoHighLevel location, workflow, and field ids. Restrict so account deletion cannot erase them.
  /// Not a ClientGhlDestination and not read by delivery.
  ghlDestinationConfigurationRequests GhlDestinationConfigurationRequest[]
  /// Intended Company Sheets spreadsheet and worksheet. Restrict so account deletion cannot erase them.
  /// Not a CompanySheetsDestination and not read by delivery, dispatch, or routing.
  companySheetsDestinationConfigurationRequests CompanySheetsDestinationConfigurationRequest[]
  /// One send record per source lead. Restrict so account deletion cannot erase send history.
  deliverySuccessNotifications DeliverySuccessNotification[]

  @@index([status])
}

/// Administrative setup request only. It does not configure or activate intake, routing, or delivery.
model ClientOnboardingSetup {
  id              String                            @id @default(cuid())
  clientAccountId String                            @unique
  clientAccount   ClientAccount                     @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  status          ClientSetupStatus                 @default(draft)
  /// Versioned, validated non-secret setup request fields. This is not operational destination config.
  setupDataJson   Json                              @default("{}")
  /// Monotonic optimistic-concurrency token. A client with no setup has revision 0.
  revision        Int                               @default(1)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt
  auditEvents     ClientOnboardingSetupAuditEvent[]

  @@index([status, updatedAt])
}

/// Append-only audit for administrative setup saves and review transitions.
model ClientOnboardingSetupAuditEvent {
  id                        String                 @id @default(cuid())
  setupId                   String?
  setup                     ClientOnboardingSetup? @relation(fields: [setupId], references: [id], onDelete: SetNull)
  /// Current attribution; updated when a live client identity is rekeyed.
  clientAccountId           String
