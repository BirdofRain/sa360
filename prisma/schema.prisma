/// One client email per source lead, even when GHL and Sheets both qualify.
/// idempotencyKey is client_lead:{clientAccountId}:{sourceLeadEventId}.
/// Evidence ids are nullable and are not foreign keys, so this row cannot
/// change a Sheets job, a GHL run, or a webhook attempt. sent is terminal.
/// ON DELETE RESTRICT: client deletion must not erase send history.
model DeliverySuccessNotification {
  id                      String                            @id @default(cuid())
  idempotencyKey          String                            @unique
  clientAccountId         String
  clientAccount           ClientAccount                     @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Restrict)
  sourceLeadEventId       String
  sheetsJobId             String?
  ghlLiveRunId            String?
  customWebhookAttemptId  String?
  status                  DeliverySuccessNotificationStatus @default(pending)
  claimedAt               DateTime?
  attemptCount            Int                               @default(0)
  sentAt                  DateTime?
  /// Provider message id after a later assignment sends. The claim primitive never sets it.
  providerMessageId       String?
  lastError               String?
  skipReason              String?
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt

  @@unique([clientAccountId, sourceLeadEventId], map: "DeliverySuccessNotification_client_lead_key")
  @@index([status, claimedAt])
}

/// Google is the only staff identity provider.
/// This is not the Drive or Sheets OAuth connection on GoogleAccountConnection
/// or CompanyGoogleConnection.
enum StaffIdentityProvider {
  google
}

/// disabled is the safe default. active requires disabledAt to be null.
/// Disabling withdraws future correction authority and keeps the id.
enum StaffPrincipalStatus {
  disabled
  active
}

/// Recognized staff permissions. Absence of a granted row is denial.
/// admin_coc is full Admin C.O.C. access. It does not include
/// facebook_association_correction, and that correction permission does not
/// grant Admin C.O.C. access.
/// team_workspace, team_manager, and team_operations are staff workspace
/// permissions. None of them grants admin_coc.
enum StaffPermissionKey {
  facebook_association_correction
  admin_coc
  team_workspace
  team_manager
  team_operations
}

/// Explicit grant state. revoked is not authorization.
/// A later grant is a new row. A revoked row cannot return to granted.
enum StaffPermissionStatus {
  granted
  revoked
}

/// Provisioned SA360 staff identity.
/// Not an Admin C.O.C. session, Team Workspace membership, portal account,
/// observer, Meta reviewer, or Agent Workspace credential.
///
/// email is a normalized mailbox label. It is not proof of authentication.
/// The permanent binding is provider + providerSubject (Google's `sub`) after
/// an approved enrollment sets providerSubject. Null providerSubject means the
/// principal is provisioned and not yet bound. PostgreSQL treats those nulls as
/// distinct on StaffPrincipal_provider_subject_key.
///
/// status defaults to disabled and disabledAt defaults to now(), so a generic
/// insert is not an active staff identity. Activation must set status to active
/// and disabledAt to null in the same write. There is no password column and no
/// OAuth token column. Creating a row does not grant a permission.
///
/// SQL triggers reject id changes, changes to a binding once providerSubject is
/// set, DELETE, and TRUNCATE. Do not drop those triggers from a later diff.
model StaffPrincipal {
  id              String                @id @default(cuid())
  /// Lowercase trimmed mailbox. Unique. Not an authentication proof.
  email           String                @unique
  /// IdP claim recorded later. true does not grant access or create a permission.
  emailVerified   Boolean               @default(false)
  displayName     String?
  provider        StaffIdentityProvider @default(google)
  /// Google `sub`, or null until an approved enrollment binds it. Immutable once set.
  providerSubject String?
  status          StaffPrincipalStatus  @default(disabled)
  /// Required while disabled. Must be null while active.
  disabledAt      DateTime?             @default(now())
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  permissions      StaffPermission[]
  enrollmentGrants StaffEnrollmentGrant[]
  invitations      StaffInvitation[]       @relation("StaffInvitationSubject")
  invitationsSent  StaffInvitation[]       @relation("StaffInvitationInviter")
  managementEvents StaffManagementEvent[]  @relation("StaffManagementEventSubject")

  @@unique([provider, providerSubject], map: "StaffPrincipal_provider_subject_key")
  @@index([status])
}

/// One explicit permission grant for one staff principal.
/// Deny by default: no row, a revoked row, or a disabled principal does not authorize.
/// There is no role column. Admin, workspace, portal, and operator credentials do not
/// create a row.
///
/// Effective uniqueness is the SQL partial unique index
/// StaffPermission_one_effective_grant_key on (staffPrincipalId, permission)
/// WHERE status = 'granted'. Prisma 6 cannot express that filter as @@unique.
/// Do not add @@unique([staffPrincipalId, permission]): revoked history must remain.
/// If prisma migrate diff proposes DROP INDEX for that name, reject the drop.
///
/// The foreign key is ON DELETE RESTRICT and ON UPDATE RESTRICT. Delete triggers
/// keep the principal id and the grant row for later audit. Revocation sets status
/// to revoked and revokedAt. A replacement grant is a new row.
model StaffPermission {
  id               String                @id @default(cuid())
  staffPrincipalId String
  staffPrincipal   StaffPrincipal        @relation(fields: [staffPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission       StaffPermissionKey
  status           StaffPermissionStatus
  grantedAt        DateTime              @default(now())
  revokedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([staffPrincipalId, permission])
}

/// One-time authorization to bind one Google subject to one existing principal.
/// The invitation secret is not stored. secretDigest is its SHA-256 hex.
/// A pending row is the only usable grant. Consumed and canceled are terminal.
/// This table does not grant a StaffPermission.
enum StaffEnrollmentGrantStatus {
  pending
  consumed
  canceled
}

enum StaffEnrollmentEventKind {
  issued
  canceled
  consumed
}

model StaffEnrollmentGrant {
  id               String                     @id @default(cuid())
  staffPrincipalId String
  staffPrincipal   StaffPrincipal             @relation(fields: [staffPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  secretDigest     String                     @unique
  status           StaffEnrollmentGrantStatus @default(pending)
  expiresAt        DateTime
  consumedAt       DateTime?
  canceledAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  events           StaffEnrollmentEvent[]

  @@index([staffPrincipalId, status])
}

/// Append-only enrollment audit. No OAuth token and no invitation secret.
model StaffEnrollmentEvent {
  id               String                   @id @default(cuid())
  grantId          String
  grant            StaffEnrollmentGrant     @relation(fields: [grantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staffPrincipalId String
  kind             StaffEnrollmentEventKind
  googleSub        String?
  createdAt        DateTime                 @default(now())

  @@index([staffPrincipalId, createdAt])
}

/// Approved mailbox invitation. There is no bearer secret.
/// The employee proves the mailbox with Google. pending is the only usable row.
/// expired is pending whose expiresAt has passed. consumed and canceled are terminal.
enum StaffAccessLevel {
  administrator
  manager
  operations
}

enum StaffInvitationStatus {
  pending
  consumed
  canceled
}

model StaffInvitation {
  id                       String                 @id @default(cuid())
  staffPrincipalId         String
  staffPrincipal           StaffPrincipal         @relation("StaffInvitationSubject", fields: [staffPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Normalized mailbox copied from the principal. Not proof of authentication.
  email                    String
  /// Label recorded at invite time. Authorization is StaffPermission, not this label.
  accessLevel              StaffAccessLevel
  status                   StaffInvitationStatus  @default(pending)
  expiresAt                DateTime
  invitedByStaffPrincipalId String
  invitedBy                StaffPrincipal         @relation("StaffInvitationInviter", fields: [invitedByStaffPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consumedAt               DateTime?
  canceledAt               DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([staffPrincipalId, status])
  @@index([email, status])
}

/// Append-only staff administration audit. No OAuth token and no invitation secret.
enum StaffManagementEventKind {
  invited
  invitation_renewed
  invitation_canceled
  invitation_consumed
  invitation_email_sent
  invitation_email_skipped
  role_changed
  permissions_revoked
  disabled
  signed_in
  claim_rejected
}

model StaffManagementEvent {
  id                    String                    @id @default(cuid())
  staffPrincipalId      String
  staffPrincipal        StaffPrincipal            @relation("StaffManagementEventSubject", fields: [staffPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorStaffPrincipalId String?
  kind                  StaffManagementEventKind
  /// Short machine code. Never a token, secret, or URL query.
  detail                String?
  googleSub             String?
  createdAt             DateTime                  @default(now())

  @@index([staffPrincipalId, createdAt])
}
