// --- Phase 4A: Campaign routing registry (dry-run only; no GHL delivery) ---

enum CampaignRoutingMatchType {
  campaign_id
  adset_id
  ad_id
  form_id_utm_campaign
  utm_campaign
  keyword_fallback
}

/// Operator confirmation state for a SourceFunnel origin-client association.
/// Suggestions never stamp inventory; only `confirmed` establishes origin ownership.
enum SourceFunnelAssociationStatus {
  unassociated
  suggested
  confirmed
}

/// Persistent registry of LeadCapture NextGen sources.
/// Identity is providerFunnelId (immutable UUID when present) and/or parentUrlKey
/// (normalized hostname+path). pageSlug is operator convenience only — not globally unique.
/// At least one of providerFunnelId / parentUrlKey is required (DB check + service).
/// Client association is never a prerequisite for inventory. Not a routing rule.
model SourceFunnel {
  id                       String                         @id @default(cuid())
  provider                 SourceLeadProvider
  /// Immutable LeadCapture funnel/form UUID when the provider supplies one. Nullable so
  /// parent_url_key-only sources are not stored as fake UUIDs.
  providerFunnelId         String?
  /// Canonical hostname + pathname, e.g. my.leadcapture.io/p/dn_omzoj. Query is never part of identity.
  parentUrlKey             String?
  /// Last path segment of the hosted page (operator convenience). Not a global unique key.
  pageSlug                 String?
  observedFunnelName       String?
  nicheKey                 String?
  associationStatus        SourceFunnelAssociationStatus @default(unassociated)
  suggestedClientAccountId String?
  suggestedClientAccount   ClientAccount?                  @relation("SourceFunnelSuggestedClient", fields: [suggestedClientAccountId], references: [clientAccountId], onDelete: SetNull)
  /// Confirmed ClientAccount this funnel was originally generated for. Immutable across renames.
  originClientAccountId    String?
  originClientAccount      ClientAccount?                  @relation("SourceFunnelOriginClient", fields: [originClientAccountId], references: [clientAccountId], onDelete: SetNull)
  /// First natural lead observation. Null when an operator pre-registered the source before any lead.
  firstSeenAt              DateTime?
  lastSeenAt               DateTime?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt

  @@unique([provider, providerFunnelId])
  @@unique([provider, parentUrlKey])
  @@index([associationStatus])
  @@index([originClientAccountId])
  @@index([suggestedClientAccountId])
  @@index([lastSeenAt])
  @@index([provider, pageSlug])
}

/// Config-driven rules mapping master VET attribution → destination client/subaccount.
model CampaignRoutingRule {
  id                            String                   @id @default(cuid())
  /// Master account that receives the inbound lead (payload `client_account_id`).
  masterClientAccountId         String
  /// Destination client tenant.
  clientAccountId               String
