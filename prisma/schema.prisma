/// Per-row audit for bulk import batches.
model BulkLeadImportRow {
  id                      String                            @id @default(cuid())
  bulkImportId            String
  bulkImport              BulkLeadImport                    @relation(fields: [bulkImportId], references: [id], onDelete: Cascade)
  rowNumber               Int
  rawRowJson              Json
  normalizedPhone         String?
  normalizedEmail         String?
  sourceLeadId            String?
  sourceLeadIdGenerated   Boolean                           @default(false)
  sourceLeadEventId       String?
  validationStatus        BulkLeadImportRowValidationStatus @default(pending)
  duplicateStatus         BulkLeadImportRowDuplicateStatus  @default(none)
  deliveryStatus          BulkLeadImportRowDeliveryStatus   @default(pending)
  errorCode               String?
  errorSummary            String?
  blockerReasonsJson      Json?
  duplicateCandidatesJson Json?
  ghlContactId            String?
  ghlOpportunityId        String?
  excluded                Boolean                           @default(false)
  deliveryAttempts        Int                               @default(0)
  lastDeliveryAt          DateTime?
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt

  @@unique([bulkImportId, rowNumber])
  @@index([bulkImportId, validationStatus])
  @@index([bulkImportId, deliveryStatus])
  @@index([bulkImportId, excluded])
  @@index([sourceLeadId])
  @@index([sourceLeadEventId])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
}

/// Reusable CSV column mapping templates for bulk imports.
model BulkLeadImportMappingTemplate {
  id          String   @id @default(cuid())
  name        String
  sourceLabel String?
  mappingJson Json
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

enum LeadOrderStatus {
  draft
  submitted
  needs_setup
  needs_compliance
  ready
  active
  paused
  completed
  canceled
}

enum LeadOrderCreatedByRole {
  admin
  client
  system
}

/// Operational payment confirmation — independent of order status and prices.
enum LeadOrderPaymentConfirmationStatus {
  pending_confirmation
  confirmed
  not_required
}

enum LeadOrderKind {
  retainer_allocation
  pay_per_lead
}

enum LeadFulfillmentMode {
  campaign_bound
  pooled_matching
}

enum LeadEligibilityStatus {
  eligible
  review_required
  ineligible
}

enum LeadAllocationStatus {
  shadow
  reserved
  delivering
  committed
  released
  review_required
}

enum DeliveryInstructionStatus {
  planned
  queued
  executing
  completed
  failed
  canceled
  review_required
}

enum DeliveryAttemptMode {
  simulation
  live
}

enum DeliveryAttemptStatus {
  planned
  claimed
  in_progress
  succeeded
  retryable_failure
  terminal_failure
  unknown_outcome
  skipped
}

enum FulfillmentOutboxStatus {
  pending
  enqueued
  processing
  completed
  retryable_failure
  terminal_failure
}

/// Client lead order for Front Office fulfillment tracking.
/// Payment confirmation is an independent dimension — do not infer it from
/// status, approvedAt, prices, or fulfillment counters.
model LeadOrder {
  id                       String                 @id @default(cuid())
  orderNumber              String                 @unique
  clientAccountId          String
  clientDisplayName        String?
  status                   LeadOrderStatus        @default(submitted)
  nicheKey                 String
  productType              String?
  statesJson               Json                   @default("[]")
  leadVolume               Int
  deliveryCadence          String?
  campaignType             String
  crmPackage               String
  aiVoiceAddon             Boolean                @default(false)
  requestedStartDate       DateTime?
  deliveryDestinationType  String?
  deliveryDestinationLabel String?
  notes                    String?
  adminNotes               String?
  trustStatusSnapshotJson  Json?
  routingRuleId            String?
  campaignId               String?
  createdByRole            LeadOrderCreatedByRole
  createdByUserId          String?
  submittedAt              DateTime?
  approvedAt               DateTime?
  activatedAt              DateTime?
  pausedAt                 DateTime?
  completedAt              DateTime?
  canceledAt               DateTime?
  /// Explicit operational payment confirmation. Default is pending for new
  /// rows and existing rows (no inference from status or prices).
  paymentConfirmationStatus LeadOrderPaymentConfirmationStatus @default(pending_confirmation)
  paymentConfirmedAt        DateTime?
  paymentConfirmedBy        String?
  /// LF2 shadow fulfillment — commercial matching fields (nullable for legacy rows).
  orderKind                LeadOrderKind?
  fulfillmentMode          LeadFulfillmentMode?
  requestedQuantity        Int?
  fulfillmentCycleStart    DateTime?
  fulfillmentCycleEnd      DateTime?
  allowedSourceLanesJson   Json                   @default("[]")
  proofPolicyKey           String?
  exclusivityRequired      Boolean                @default(false)
  fulfillmentPriority      Int                    @default(100)
  /// Shadow/reserved/fulfilled counters — shadow does not decrement requestedQuantity.
  proposedQuantity         Int                    @default(0)
  reservedQuantity         Int                    @default(0)
  fulfilledQuantity        Int                    @default(0)
  /// Extra unbilled reservation slots for operator review buffers / supplementals.
  /// Never treated as purchased or billed quantity. Default 0 preserves exact-fill.
  reviewCapacityAllowance  Int                    @default(0)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  leadAllocations            LeadAllocation[]
  orderLines                 LeadOrderLine[]
  leadDeliveryExportPackages LeadDeliveryExportPackage[]
  leadReplacementRequests    LeadReplacementRequest[]
  pplOperatorReviewBatches   PplOperatorReviewBatch[]

  @@index([clientAccountId, createdAt])
  @@index([status, createdAt])
  @@index([nicheKey])
  @@index([orderKind, status, fulfillmentMode])
  @@index([fulfillmentPriority, activatedAt])
}

/// Channel-neutral client delivery destination (adapter resolved by adapterKey).
///
/// One Google Sheets destination per client is a SQL partial unique index
/// (`DeliveryTarget_clientAccount_googleSheets_key`: clientAccountId WHERE
/// adapterKey = 'google_sheets.v1'). Prisma 6 cannot express filtered unique
/// indexes. Do **not** add @@unique([clientAccountId]) — a client may hold a
/// GHL target and a Sheets target at once. `prisma migrate diff` / `migrate dev`
/// may propose DROP INDEX for this name; reject that.
model DeliveryTarget {
  id                   String                @id @default(cuid())
  clientAccountId      String
  clientAccount        ClientAccount         @relation(fields: [clientAccountId], references: [clientAccountId], onDelete: Cascade)
  displayName          String
  /// Extensible adapter identifier, e.g. ghl.crm.v1, webhook.generic.v1
  adapterKey           String
  enabled              Boolean               @default(true)
  isPrimary            Boolean               @default(false)
  isRequired           Boolean               @default(false)
  /// Non-secret configuration metadata only — credentials live elsewhere.
  configMetadataJson   Json                  @default("{}")
  readinessStatus      String                @default("not_configured")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deliveryInstructions DeliveryInstruction[]
  /// Optional secret row for webhook.generic.v1. The signing secret is not stored here.
  customWebhookDestination ClientCustomWebhookDestination?

  @@index([clientAccountId, enabled])
  @@index([adapterKey])
}

/// Durable eligibility assessment for a source lead and policy version.
model LeadEligibilityAssessment {
  id                      String                @id @default(cuid())
  sourceLeadEventId       String
  sourceLeadEvent         SourceLeadEvent       @relation(fields: [sourceLeadEventId], references: [id], onDelete: Cascade)
  policyKey               String
  policyVersion           String
  status                  LeadEligibilityStatus
  reasonCodesJson         Json                  @default("[]")
  proofResultJson         Json?
  duplicateResultJson     Json?
  requiredFieldResultJson Json?
  geographyResultJson     Json?
  consentResultJson       Json?
  evaluatedAt             DateTime              @default(now())
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@unique([sourceLeadEventId, policyKey, policyVersion])
  @@index([status, evaluatedAt])
  @@index([policyKey, policyVersion])
}

/// Commercial allocation — who owns the lead (shadow/reserved/committed).
model LeadAllocation {
  id                        String                @id @default(cuid())
  sourceLeadEventId         String
  sourceLeadEvent           SourceLeadEvent       @relation(fields: [sourceLeadEventId], references: [id], onDelete: Cascade)
  leadOrderId               String
  leadOrder                 LeadOrder             @relation(fields: [leadOrderId], references: [id], onDelete: Restrict)
  leadOrderLineId           String?
  leadOrderLine             LeadOrderLine?        @relation(fields: [leadOrderLineId], references: [id], onDelete: SetNull)
  leadInventoryItemId       String?
  leadInventoryItem         LeadInventoryItem?    @relation(fields: [leadInventoryItemId], references: [id], onDelete: SetNull)
  clientAccountId           String
  status                    LeadAllocationStatus  @default(shadow)
  allocationPolicyVersion   String
  decisionReasonsJson       Json                  @default("[]")
  candidateCount            Int                   @default(0)
  idempotencyKey            String                @unique
  /// Idempotent replay key for manual reservation (one reservation claim per allocation).
  reservationIdempotencyKey String?               @unique
  reservationPolicyVersion  String?
  releaseReasonJson         Json?
  reviewReasonJson          Json?
  proposedAt                DateTime              @default(now())
  reservedAt                DateTime?
  committedAt               DateTime?
  releasedAt                DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  deliveryInstructions      DeliveryInstruction[]

  @@index([sourceLeadEventId])
  @@index([leadOrderId, status])
  @@index([clientAccountId, status])
  @@index([sourceLeadEventId, status])
  @@index([leadOrderLineId])
  @@index([leadInventoryItemId])
}

/// Immutable buyer-safe CSV delivery package (PPL aged inventory beta).
model LeadDeliveryExportPackage {
  id                 String    @id @default(cuid())
  leadOrderId        String
  leadOrder          LeadOrder @relation(fields: [leadOrderId], references: [id], onDelete: Restrict)
  clientAccountId    String
  format             String    @default("csv_v1")
  rowCount           Int
  contentSha256      String
  idempotencyKey     String    @unique
  fieldSchemaVersion String
  /// Stable sorted list of allocation ids included in this package.
  allocationIdsJson  Json      @default("[]")
  /// Canonical UTF-8 CSV bytes (buyer-safe allowlist only).
  csvContent         String
  /// Immutable commercial/export audit snapshot (schema version, pricing, bucket, counts).
  metadataJson       Json?
  createdBy          String?
  createdAt          DateTime  @default(now())
  /// Explicit operator-recorded spreadsheet delivery (not set by export commit/download alone).
  spreadsheetDeliveredAt           DateTime?
  spreadsheetDeliveredBy           String?
  spreadsheetDeliveryIdempotencyKey String?   @unique
  /// Audit: phrase, note, checksum, allocation ids, actor, recordedAt.
  spreadsheetDeliveryEvidenceJson  Json?
  /// Customer "order is ready" email state. Independent of release.
  /// pending|sending|sent|skipped|failed — never gates spreadsheetDeliveredAt or download.
  customerReleaseNotifyStatus      String?
  customerReleaseNotifyClaimedAt   DateTime?
  customerReleaseNotifiedAt        DateTime?
  customerReleaseNotifyError       String?
  customerReleaseNotifyProviderId  String?

  @@index([leadOrderId, createdAt])
  @@index([clientAccountId, createdAt])
  @@index([contentSha256])
  @@index([spreadsheetDeliveredAt])
  @@index([customerReleaseNotifyStatus])
}

/// Duplicate-only replacement request for a previously delivered PPL allocation.
model LeadReplacementRequest {
  id                         String    @id @default(cuid())
  clientAccountId            String
  leadOrderId                String
  leadOrder                  LeadOrder @relation(fields: [leadOrderId], references: [id], onDelete: Restrict)
  originalAllocationId       String
  originalInventoryItemId    String?
  status                     String // requested|approved|denied|fulfilled|canceled
  reason                     String
  reasonCode                 String    @default("duplicate")
  replacementAllocationId    String?
  replacementInventoryItemId String?
  decisionNote               String?
  decidedBy                  String?
  decidedAt                  DateTime?
  fulfilledAt                DateTime?
  canceledAt                 DateTime?
  requestId                  String    @unique
  createdBy                  String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([leadOrderId, status])
  @@index([clientAccountId, status])
  @@index([originalAllocationId])
  @@index([status, createdAt])
}

/// Pre-delivery operator review buffer for a PPL order.
/// Unused buffers and supplemental fills are never auto-billed.
model PplOperatorReviewBatch {
  id                 String   @id @default(cuid())
  leadOrderId        String
  leadOrder          LeadOrder @relation(fields: [leadOrderId], references: [id], onDelete: Restrict)
  clientAccountId    String
  status             String // open|closed|canceled
  purchasedQuantity  Int
  bufferQuantity     Int
  acceptedCount      Int      @default(0)
  rejectedCount      Int      @default(0)
  unusedBufferCount  Int      @default(0)
  shortfallCount     Int      @default(0)
  /// Operator-set only. Services never infer this from buffers or supplementals.
  billedQuantity     Int?
  requestId          String   @unique
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items               PplOperatorReviewItem[]
  supplementalExports PplSupplementalExport[]

  @@index([leadOrderId, status])
  @@index([clientAccountId, status])
  /// One open batch per order is a SQL partial unique index
  /// (`PplOperatorReviewBatch_one_open_per_order`: leadOrderId WHERE status = 'open').
  /// Prisma 6 cannot express filtered unique indexes.
}

/// One reserved allocation under operator review. Rejected rows are never delivered.
model PplOperatorReviewItem {
  id                String   @id @default(cuid())
  batchId           String
  batch             PplOperatorReviewBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  allocationId      String
  inventoryItemId   String?
  sourceLeadEventId String
  role              String // primary|buffer|supplemental
  status            String // pending_review|accepted|rejected|unused
  rejectionReason   String?
  reviewFlagsJson   Json?
  decidedBy         String?
  decidedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([batchId, allocationId])
  @@index([batchId, status])
  @@index([allocationId])
}

/// Supplemental reservation/export that fills an operator-review shortfall.
/// billingStatus is always not_billed unless an operator later records a bill by hand.
model PplSupplementalExport {
  id                String   @id @default(cuid())
  batchId           String
  batch             PplOperatorReviewBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  leadOrderId       String
  exportPackageId   String?
  shortfallQuantity Int
  selectedQuantity  Int      @default(0)
  status            String // reserved|previewed|committed|canceled
  billingStatus     String   @default("not_billed")
  /// Allocation IDs reserved for this shortfall cycle (not the original export).
  allocationIdsJson Json     @default("[]")
  requestId         String   @unique
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([batchId, status])
  @@index([leadOrderId])
}

/// Planned delivery instruction linking allocation to a delivery target.
model DeliveryInstruction {
  id               String                    @id @default(cuid())
  leadAllocationId String
  leadAllocation   LeadAllocation            @relation(fields: [leadAllocationId], references: [id], onDelete: Cascade)
  deliveryTargetId String
  deliveryTarget   DeliveryTarget            @relation(fields: [deliveryTargetId], references: [id], onDelete: Restrict)
  sequence         Int
  isRequired       Boolean                   @default(true)
  status           DeliveryInstructionStatus @default(planned)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  deliveryAttempts DeliveryAttempt[]

  @@unique([leadAllocationId, deliveryTargetId])
  @@index([leadAllocationId, sequence])
}

/// Immutable audit row for each provider-neutral delivery execution attempt.
model DeliveryAttempt {
  id                    String                @id @default(cuid())
  deliveryInstructionId String
  deliveryInstruction   DeliveryInstruction   @relation(fields: [deliveryInstructionId], references: [id], onDelete: Cascade)
  adapterKey            String
  attemptNumber         Int
  idempotencyKey        String                @unique
  executionMode         DeliveryAttemptMode
  status                DeliveryAttemptStatus @default(planned)
  requestFingerprint    String?
  sanitizedRequestJson  Json?
  sanitizedResponseJson Json?
  externalReference     String?
  errorCode             String?
  errorSummary          String?
  retryable             Boolean               @default(false)
  startedAt             DateTime?
  completedAt           DateTime?
  nextRetryAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([deliveryInstructionId, attemptNumber])
  @@index([deliveryInstructionId, status])
  @@index([status, createdAt])
}

/// Durable fulfillment work outbox — survives enqueue failures.
model FulfillmentOutbox {
  id                String                  @id @default(cuid())
  idempotencyKey    String                  @unique
  sourceLeadEventId String
  sourceLeadEvent   SourceLeadEvent         @relation(fields: [sourceLeadEventId], references: [id], onDelete: Cascade)
  workType          String
  status            FulfillmentOutboxStatus @default(pending)
  attemptCount      Int                     @default(0)
  availableAt       DateTime                @default(now())
  lastErrorJson     Json?
  createdAt         DateTime                @default(now())
  enqueuedAt        DateTime?
  processingAt      DateTime?
  completedAt       DateTime?
  updatedAt         DateTime                @updatedAt

  @@index([status, availableAt])
  @@index([sourceLeadEventId])
  @@index([workType, status])
}

// --- Lead Inventory Foundation v1 ---

enum InventoryLotStatus {
  draft
  ingesting
  active
  paused
  exhausted
  quarantined
  archived
}

enum LeadInventoryClass {
  fresh
  aged
  recycled
  referral
  imported
  purchased
}

enum InventoryExclusivityMode {
  exclusive
  shared
  configurable
}

enum LeadInventoryItemStatus {
  pending_review
  available
  reserved
  committed
  fulfilled
  quarantined
  rejected
  expired
  withdrawn
}

enum LeadOrderLineStatus {
  draft
  active
  partially_reserved
  reserved
  partially_fulfilled
  fulfilled
  canceled
}

/// Batch, campaign, import, acquisition, or generation source for inventory supply.
model InventoryLot {
  id                String                   @id @default(cuid())
  lotKey            String                   @unique
  displayName       String
  sourceProvider    SourceLeadProvider
  sourceLane        String
  supplierAccountId String?
  campaignId        String?
  campaignName      String?
  formId            String?
  externalBatchId   String?
  nicheKey          String
  productType       String?
  inventoryClass    LeadInventoryClass
  exclusivityMode   InventoryExclusivityMode @default(configurable)
  status            InventoryLotStatus       @default(draft)
  generatedFrom     DateTime?
  generatedTo       DateTime?
  acquiredAt        DateTime?
  activatedAt       DateTime?
  pausedAt          DateTime?
  archivedAt        DateTime?
  metadataJson      Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  inventoryItems LeadInventoryItem[]

  @@index([status, inventoryClass])
  @@index([sourceLane, status])
  @@index([nicheKey, status])
}

/// Buyer identity fingerprints recorded after successful PPL delivery.
model BuyerDeliveredIdentity {
  id                  String   @id @default(cuid())
  clientAccountId     String
  phoneFingerprint    String?
  emailFingerprint    String?
  sourceLeadEventId   String
  leadAllocationId    String
  leadInventoryItemId String?
  recordedAt          DateTime @default(now())

  @@unique([clientAccountId, sourceLeadEventId])
  @@index([clientAccountId, phoneFingerprint])
  @@index([clientAccountId, emailFingerprint])
  @@index([leadAllocationId])
}

/// Preview/apply batch for historical spreadsheet receipts. Never writes BuyerDeliveredIdentity.
model BuyerExternalDeliveryImportBatch {
  id                           String    @id @default(cuid())
  clientAccountId              String
  requestId                    String    @unique
  sourceLabel                  String
  sourceFilename               String?
  contentChecksum              String
  occupiedRowCount             Int
  uniqueLeadCount              Int
  extraOccupiedRowCount        Int
  blankRowCount                Int
  headerRowCount               Int       @default(0)
  malformedCount               Int       @default(0)
  matchedCount                 Int       @default(0)
  unmatchedCount               Int       @default(0)
  ambiguousCount               Int       @default(0)
  rejectedBeforeDeliveryCount  Int       @default(0)
  confirmedUnmatchedCount      Int       @default(0)
  sourceEvidence               String?
  unmatchedDeliveriesConfirmed Boolean   @default(false)
  applyMode                    String    @default("preview")
  status                       String // previewed|applied|canceled
  createdBy                    String?
  appliedBy                    String?
  appliedAt                    DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  receipts BuyerExternalDeliveryReceipt[]

  @@index([clientAccountId, status])
  @@index([contentChecksum])
}

/// One occupied or blank spreadsheet row imported as a buyer-specific receipt.
/// Applied rows suppress future selection for this buyer only. Preview rows do not.
model BuyerExternalDeliveryReceipt {
  id                       String   @id @default(cuid())
  importBatchId            String
  importBatch              BuyerExternalDeliveryImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  clientAccountId          String
  source                   String   @default("spreadsheet")
  rowNumber                Int
  occupancyStatus          String // occupied|blank
  phoneFingerprint         String?
  emailFingerprint         String?
  rawRowHash               String
  matchStatus              String // matched|unmatched|ambiguous|extra_occupied_row|blank_skipped|identity_conflict
  matchedSourceLeadEventId String?
  matchedInventoryItemId   String?
  applyStatus              String // preview|applied|suppressed_rejected_before_delivery|skipped
  applyNote                String?
  deliveryEvidenceStatus   String   @default("unverified") // unverified|operator_confirmed|not_a_delivery
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([importBatchId, rowNumber])
  @@index([clientAccountId, applyStatus])
  @@index([clientAccountId, phoneFingerprint])
  @@index([clientAccountId, emailFingerprint])
  @@index([importBatchId])
}

/// Active exclusion rules for protected agents/suppliers in PPL aged inventory selection.
model ProtectedAgentExclusion {
  id         String   @id @default(cuid())
  matchType  String // supplier_account_id | agent_id | normalized_agent_name
  matchValue String
  active     Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([matchType, matchValue])
  @@index([active, matchType])
}

/// One lead as commercially usable inventory supply.
model LeadInventoryItem {
  id                   String                   @id @default(cuid())
  inventoryLotId       String
  inventoryLot         InventoryLot             @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)
  sourceLeadEventId    String                   @unique
  sourceLeadEvent      SourceLeadEvent          @relation(fields: [sourceLeadEventId], references: [id], onDelete: Restrict)
  generatedAt          DateTime
  normalizedState      String
  nicheKey             String
  productType          String?
  sourceProvider       SourceLeadProvider
  sourceLane           String
  inventoryClass       LeadInventoryClass
  exclusivityMode      InventoryExclusivityMode @default(configurable)
  status               LeadInventoryItemStatus  @default(pending_review)
  quarantineReason     String?
  availableAt          DateTime?
  reservedAt           DateTime?
  committedAt          DateTime?
  withdrawnAt          DateTime?
  expiredAt            DateTime?
  rejectedAt           DateTime?
  /// Permanent commerce kill switch. Orthogonal to status, FRESH_HOLD, and suppression.
  /// NULL means the item may be selected if other sellability predicates pass.
  commerceExcludedAt     DateTime?
  commerceExcludedReason String?
  commerceExcludedBy     String?
  maxFulfillments      Int                      @default(1)
  fulfillmentCount     Int                      @default(0)
  acquisitionCostCents Int?
  internalValueCents   Int?
  metadataJson         Json?
  /// Canonical consumer identity fingerprints (SHA-256 of normalized phone/email).
  /// Additive, nullable — used for indexed campaign/webhook dedup. Not buyer-delivery identity.
  phoneFingerprint     String?
  emailFingerprint     String?
  /// ClientAccount this consumer lead was originally generated for (confirmed SourceFunnel only).
  /// Not the current buyer, delivery destination, routing owner, supplier, or allocated buyer.
  originClientAccountId String?
  originClientAccount    ClientAccount? @relation("LeadInventoryOriginClient", fields: [originClientAccountId], references: [clientAccountId], onDelete: SetNull)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  leadAllocations   LeadAllocation[]
  reviewItemResults LeadInventoryReviewItemResult[]

  @@index([generatedAt])
  @@index([normalizedState])
  @@index([status])
  @@index([inventoryLotId, status])
  @@index([nicheKey, normalizedState, status])
  @@index([sourceLane, status])
  @@index([inventoryClass, status])
  @@index([rejectedAt])
  @@index([phoneFingerprint])
  @@index([emailFingerprint])
  @@index([originClientAccountId])
}

/// Configurable versioned age categories for inventory filtering.
model LeadAgeBandDefinition {
  id               String    @id @default(cuid())
  version          String
  key              String
  label            String
  minDaysInclusive Int
  maxDaysExclusive Int?
  sortOrder        Int
  active           Boolean   @default(true)
  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([version, key])
  @@index([version, active, sortOrder])
}

/// Build lifecycle for precomputed Lead Inventory facets supply snapshots.
enum LeadInventoryFacetBuildStatus {
  building
  validated
  active
  failed
  retired
}

/// Versioned supply-snapshot build metadata (one active build per ageBandVersion).
model LeadInventoryFacetBuild {
  id                String                        @id @default(cuid())
  ageBandVersion    String
  evaluatedAt       DateTime
  status            LeadInventoryFacetBuildStatus
  inventoryCount    Int                           @default(0)
  aggregateRowCount Int                           @default(0)
  buildDurationMs   Int?
  validationOk      Boolean                       @default(false)
  activatedAt       DateTime?
  failureCode       String?
  failureDetailJson Json?
  metadataJson      Json?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  aggregates LeadInventoryFacetSupplyAggregate[]

  @@index([status, ageBandVersion])
  @@index([ageBandVersion, activatedAt])
  @@index([createdAt])
}

/// Dimensional supply aggregate grain for one facets snapshot build.
/// productType empty string represents the null/unknown product bucket.
model LeadInventoryFacetSupplyAggregate {
  id              String                 @id @default(cuid())
  buildId         String
  build           LeadInventoryFacetBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  ageBandVersion  String
  nicheKey        String
  productType     String                 @default("")
  inventoryClass  String
  sourceLane      String
  lotId           String
  itemStatus      String
  normalizedState String
  ageBandKey      String
  total           Int
  available       Int
  reserved        Int
  blocked         Int
  createdAt       DateTime               @default(now())

  @@unique([buildId, ageBandVersion, nicheKey, productType, inventoryClass, sourceLane, lotId, itemStatus, normalizedState, ageBandKey], map: "LeadInventoryFacetSupplyAggregate_grain_key")
  @@index([buildId, normalizedState, ageBandKey])
  @@index([buildId, nicheKey, inventoryClass, sourceLane, lotId, itemStatus])
  @@index([ageBandVersion, buildId])
}

/// One requested inventory product within a LeadOrder.
model LeadOrderLine {
  id                     String              @id @default(cuid())
  leadOrderId            String
  leadOrder              LeadOrder           @relation(fields: [leadOrderId], references: [id], onDelete: Cascade)
  lineNumber             Int
  displayName            String?
  nicheKey               String
  productType            String?
  requestedQuantity      Int
  normalizedStatesJson   Json                @default("[]")
  ageBandKeysJson        Json                @default("[]")
  minAgeDays             Int?
  maxAgeDays             Int?
  inventoryClassesJson   Json                @default("[]")
  allowedSourceLanesJson Json                @default("[]")
  exclusivityRequired    Boolean             @default(false)
  unitPriceCents         Int?
  lineTotalCents         Int?
  fulfillmentPriority    Int                 @default(100)
  status                 LeadOrderLineStatus @default(draft)
  reservedQuantity       Int                 @default(0)
  fulfilledQuantity      Int                 @default(0)
  /// PPL pricing snapshot metadata (pricingVersion, commerceAgeBucketKey, quotedAt).
  metadataJson           Json?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  leadAllocations LeadAllocation[]

  @@unique([leadOrderId, lineNumber])
  @@index([leadOrderId, status])
  @@index([nicheKey, status])
}

// --- Aged Lead Inventory Ingestion v1 (stacked on foundation) ---

enum LeadInventoryImportBatchStatus {
  previewed
  ready
  committed
  blocked
  failed
  canceled
}

/// Audit record for guarded aged CSV inventory import (no raw CSV bytes or contact PII).
model LeadInventoryImportBatch {
  id              String                         @id @default(cuid())
  requestId       String                         @unique
  lotKey          String?
  fileName        String
  fileFingerprint String
  uploadedBy      String?
  operatorNote    String?
  inventoryClass  LeadInventoryClass             @default(aged)
  exclusivityMode InventoryExclusivityMode
  nicheKey        String
  productType     String?
  sourceProvider  SourceLeadProvider
  sourceLane      String
  totalRows       Int                            @default(0)
  validRows       Int                            @default(0)
  invalidRows     Int                            @default(0)
  duplicateRows   Int                            @default(0)
  quarantinedRows Int                            @default(0)
  importedRows    Int                            @default(0)
  status          LeadInventoryImportBatchStatus @default(previewed)
  mappingJson     Json                           @default("{}")
  summaryJson     Json                           @default("{}")
  previewedAt     DateTime?
  committedAt     DateTime?
  inventoryLotId  String?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([status, createdAt])
  @@index([fileFingerprint])
  @@index([inventoryLotId])
}

// --- Aged inventory bulk CLI import (source snapshot + checkpoint) ---

enum AgedInventorySourceSnapshotStatus {
  previewed
  committing
  completed
  failed
}

/// Registry of master-file source snapshots for idempotent bulk import.
model AgedInventorySourceSnapshot {
  id                 String                            @id @default(cuid())
  fileSha256         String                            @unique
  fileName           String
  sourceFormat       String
  defaultNicheKey    String
  sourceLane         String                            @default("aged_inventory_bulk_csv")
  status             AgedInventorySourceSnapshotStatus @default(previewed)
  lotKey             String?
  inventoryLotId     String?
  importRequestId    String?
  operator           String?
  totalSourceRows    Int                               @default(0)
  parsedRows         Int                               @default(0)
  acceptedRows       Int                               @default(0)
  exactDuplicateRows Int                               @default(0)
  quarantinedRows    Int                               @default(0)
  rejectedRows       Int                               @default(0)
  importedRows       Int                               @default(0)
  nextRowNumber      Int                               @default(1)
  batchesCompleted   Int                               @default(0)
  summaryJson        Json                              @default("{}")
  checkpointJson     Json                              @default("{}")
  previewedAt        DateTime?
  committedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt

  @@index([status, createdAt])
  @@index([defaultNicheKey, status])
  @@index([inventoryLotId])
  @@index([lotKey])
}

/// Append-only audit for aged operational verification / lot activation (no PII).
model AgedInventoryOpsVerifyAction {
  id                String   @id @default(cuid())
  requestId         String   @unique
  inventoryLotId    String
  lotKey            String
  actionType        String
  actionStatus      String
  verificationKind  String   @default("aged_operational_v1")
  operator          String?
  operatorNote      String?
  requestedCount    Int      @default(0)
  passedCount       Int      @default(0)
  quarantinedCount  Int      @default(0)
  rejectedCount     Int      @default(0)
  activatedCount    Int      @default(0)
  blockedCount      Int      @default(0)
  nextCursor        String?
  summaryJson       Json     @default("{}")
  previewedAt       DateTime?
  committedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([inventoryLotId, createdAt])
  @@index([lotKey, actionType])
  @@index([actionStatus, createdAt])
}

// --- Lead Inventory Review & Activation v1 (stacked on aged ingestion) ---

enum LeadInventoryReviewActionType {
  make_available
  quarantine
  reject
}

enum LeadInventoryReviewActionStatus {
  previewed
  applied
  partially_applied
  blocked
  idempotent_replay
  failed
}

/// Append-only audit for guarded inventory review activation actions (no contact PII).
model LeadInventoryReviewAction {
  id                   String                         @id @default(cuid())
  requestId            String                         @unique
  actionType           LeadInventoryReviewActionType
  actionStatus         LeadInventoryReviewActionStatus @default(previewed)
  requestedBy          String?
  reasonCode           String?
  operatorNote         String?
  selectionFingerprint String
  requestedCount       Int                            @default(0)
  eligibleCount        Int                            @default(0)
  appliedCount         Int                            @default(0)
  blockedCount         Int                            @default(0)
  resultSummaryJson    Json                           @default("{}")
  previewedAt          DateTime?
  committedAt          DateTime?
  createdAt            DateTime                       @default(now())
